{
  "namespace": "pocket_containers",

  "panel": {
    "$bwiki_title": "$container_title",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [ { "emm_box_overlay@emm_box.overlay": {} } ]
      }
    ]
  },

  "header_area": {
    "ignored": "(('%.6s' * $bwiki_title) = '§b§w')"
  },

  "background_panel": {
    "ignored": "(('%.6s' * $bwiki_title) = '§b§w')"
  },

  "half_screen": {
    "ignored": "(('%.6s' * $bwiki_title) = '§b§w')"
  }
}
