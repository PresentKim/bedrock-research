{
  "namespace": "emm_box",

  "slot_text": {
    "type": "label", "size": "$text_size", "layer": 3, "localize": false, "text": "#text",
    "color": "$text_color", "font_scale_factor": "$text_scale", "shadow": "$text_shadow",
    "$text_size|default": [ 150, 10 ],
    "$text_color|default": [ 0.2, 0.2, 0.2 ],
    "$text_scale|default": 0.8,
    "$text_shadow|default": false,
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "(#hover_text - '§o' - '§f' - '§r')", "target_property_name": "#text" }
    ]
  },

  "slot_bar": {
    "type": "panel", "size": [ 150, 6 ],
    "controls": [
      { "back": { "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ], "layer": 3, "color": [ 0.45, 0.45, 0.45 ] } },
      {
        "fill": {
          "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ], "layer": 4, "color": [ 0.1, 0.75, 0.2 ],
          "clip_direction": "left", "clip_pixelperfect": false,
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
            { "binding_type": "view", "source_property_name": "(1 - ((#hover_text - '§o' - '§f' - '§r') * .1))", "target_property_name": "#clip_ratio" }
          ]
        }
      }
    ]
  },

  "slot": {
    "type": "stack_panel", "orientation": "vertical", "size": "$slot_size", "collection_name": "container_items",
    "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1,
    "controls": [ { "value@$value": { "collection_index": "$index" } } ]
  },

  "player_row": {
    "type": "panel", "size": [ 88, 12 ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "(not (#hover_text = ''))", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "icon": {
          "type": "custom", "renderer": "inventory_item_renderer", "size": [ 10, 10 ], "layer": 3,
          "anchor_from": "left_middle", "anchor_to": "left_middle",
          "property_bag": { "#item_id_aux": 0 },
          "bindings": [ { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#item_id_aux", "binding_condition": "always" } ]
        }
      },
      { "name@emm_box.slot_text": { "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [ 13, 1 ], "$text_size": [ 74, 10 ], "$text_scale": 0.7 } }
    ]
  },

  "players": {
    "type": "stack_panel", "orientation": "vertical", "size": [ 88, 96 ], "collection_name": "container_items",
    "controls": [
      { "p0@emm_box.player_row": { "collection_index": 6 } },
      { "p1@emm_box.player_row": { "collection_index": 7 } },
      { "p2@emm_box.player_row": { "collection_index": 8 } },
      { "p3@emm_box.player_row": { "collection_index": 9 } },
      { "p4@emm_box.player_row": { "collection_index": 10 } },
      { "p5@emm_box.player_row": { "collection_index": 11 } },
      { "p6@emm_box.player_row": { "collection_index": 12 } },
      { "p7@emm_box.player_row": { "collection_index": 13 } }
    ]
  },

  "banner": {
    "type": "panel", "size": [ 150, 34 ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "((not ((#hover_text - 'Match found') = #hover_text)) or (not ((#hover_text - 'Starting') = #hover_text)))", "target_property_name": "#visible" }
    ],
    "controls": [
      { "bg": { "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ], "layer": 2, "color": [ 0.12, 0.55, 0.2 ] } },
      { "text@emm_box.slot_text": { "anchor_from": "center", "anchor_to": "center", "$text_size": [ "default", 10 ], "$text_color": [ 1, 1, 1 ], "$text_scale": 1.0, "$text_shadow": true } }
    ]
  },

  "press_face": {
    "type": "panel", "size": [ "100%", "100%" ],
    "controls": [
      { "bg": { "type": "image", "texture": "$face_texture", "size": [ "100%", "100%" ] } },
      { "label": { "type": "label", "layer": 2, "localize": false, "color": [ 1, 1, 1 ], "shadow": true, "font_scale_factor": 0.8, "text": "$label" } }
    ]
  },

  "press_button": {
    "type": "button",
    "size": "$button_size",
    "layer": 2,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "container_items" } ],
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.container_auto_place", "mapping_type": "pressed", "consume_event": false },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.container_auto_place", "mapping_type": "focused", "consume_event": false }
    ],
    "controls": [
      { "default@emm_box.press_face": { "$face_texture": "$face_default" } },
      { "hover@emm_box.press_face": { "$face_texture": "$face_hover" } },
      { "pressed@emm_box.press_face": { "$face_texture": "$face_pressed" } }
    ]
  },

  "gated_button": {
    "type": "stack_panel", "orientation": "vertical", "size": "$button_size", "collection_name": "container_items",
    "anchor_from": "top_left", "anchor_to": "top_left", "layer": 2,
    "$face_default|default": "textures/ui/button_borderless_dark",
    "$face_hover|default": "textures/ui/button_borderless_darkhover",
    "$face_pressed|default": "textures/ui/button_borderless_darkpressed",
    "controls": [
      {
        "gate": {
          "type": "panel", "size": "$button_size", "collection_index": 1,
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
            { "binding_type": "view", "source_property_name": "$show_rule", "target_property_name": "#visible" }
          ],
          "controls": [
            {
              "inner": {
                "type": "stack_panel", "orientation": "vertical", "size": "$button_size", "collection_name": "container_items",
                "controls": [ { "button@emm_box.press_button": { "collection_index": "$index" } } ]
              }
            }
          ]
        }
      }
    ]
  },

  "window": {
    "type": "image",
    "texture": "textures/ui/dialog_background_opaque",
    "size": [ 262, 196 ],
    "layer": 2,
    "controls": [
      { "title": { "type": "label", "layer": 3, "localize": false, "color": [ 0.25, 0.25, 0.25 ], "text": "Matchmaking", "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 6 ] } },
      { "close@common.close_button": {} },
      { "status@emm_box.slot": { "offset": [ 8, 22 ], "$slot_size": [ 150, 12 ], "$index": 1, "$value": "emm_box.slot_text", "$text_size": [ 150, 12 ], "$text_scale": 1.0, "$text_color": [ 0.15, 0.15, 0.15 ] } },
      { "mode@emm_box.slot": { "offset": [ 8, 38 ], "$slot_size": [ 150, 10 ], "$index": 2, "$value": "emm_box.slot_text" } },
      { "count@emm_box.slot": { "offset": [ 8, 50 ], "$slot_size": [ 150, 10 ], "$index": 3, "$value": "emm_box.slot_text" } },
      { "bar@emm_box.slot": { "offset": [ 8, 62 ], "$slot_size": [ 150, 6 ], "$index": 4, "$value": "emm_box.slot_bar" } },
      { "time@emm_box.slot": { "offset": [ 8, 72 ], "$slot_size": [ 150, 10 ], "$index": 5, "$value": "emm_box.slot_text" } },
      { "banner@emm_box.slot": { "offset": [ 8, 92 ], "$slot_size": [ 150, 34 ], "$index": 1, "$value": "emm_box.banner" } },
      { "players_title": { "type": "label", "layer": 3, "localize": false, "color": [ 0.35, 0.35, 0.35 ], "font_scale_factor": 0.8, "text": "Players", "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 168, 24 ] } },
      { "players@emm_box.players": { "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 166, 36 ], "layer": 1 } },
      { "join_duel@emm_box.gated_button": { "offset": [ 8, 170 ], "$button_size": [ 80, 18 ], "$index": 20, "$label": "Duel (2)", "$show_rule": "(not ((#hover_text - 'Idle') = #hover_text))" } },
      { "join_squad@emm_box.gated_button": { "offset": [ 91, 170 ], "$button_size": [ 80, 18 ], "$index": 21, "$label": "Squad (4)", "$show_rule": "(not ((#hover_text - 'Idle') = #hover_text))" } },
      { "join_party@emm_box.gated_button": { "offset": [ 174, 170 ], "$button_size": [ 80, 18 ], "$index": 22, "$label": "Party (8)", "$show_rule": "(not ((#hover_text - 'Idle') = #hover_text))" } },
      { "cancel@emm_box.gated_button": { "offset": [ 8, 170 ], "$button_size": [ 120, 18 ], "$index": 26, "$label": "Leave queue", "$show_rule": "(not ((#hover_text - 'Searching') = #hover_text))" } }
    ]
  },

  "empty_cell": { "type": "panel", "size": [ 18, 18 ] },

  "overlay": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 1,
    "$bwiki_title": "$container_title",
    "controls": [
      {
        "host": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "ignored": "(not ($bwiki_title = '§b§w§m§m'))",
          "controls": [
            { "entity_ui_hide_vanilla": { "type": "panel", "size": [ 0, 0 ], "property_bag": { "#entity_ui_vanilla_visible": false } } },
            {
              "cover": {
                "type": "input_panel",
                "modal": true,
                "size": [ "100%", "100%" ],
                "layer": 1,
                "controls": [
                  {
                    "sync_grid": {
                      "type": "grid",
                      "size": [ 162, 54 ],
                      "layer": 1,
                      "grid_rescaling_type": "horizontal",
                      "maximum_grid_items": 27,
                      "collection_name": "container_items",
                      "grid_item_template": "emm_box.empty_cell"
                    }
                  },
                  { "window@emm_box.window": { "layer": 2 } }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
