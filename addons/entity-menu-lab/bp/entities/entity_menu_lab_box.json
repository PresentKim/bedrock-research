{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "bwiki:entity_menu_lab_box",
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "bwiki:size_s": { "minecraft:collision_box": { "width": 0.6, "height": 0.6 } },
      "bwiki:size_m": { "minecraft:collision_box": { "width": 1.2, "height": 1.2 } },
      "bwiki:size_l": { "minecraft:collision_box": { "width": 2.4, "height": 2.4 } },
      "bwiki:size_hit": {
        "minecraft:collision_box": { "width": 0.6, "height": 0.6 },
        "minecraft:custom_hit_test": { "hitboxes": [ { "width": 3, "height": 3, "pivot": [ 0, 0, 0 ] } ] }
      }
    },
    "components": {
      "minecraft:type_family": { "family": [ "parrot_tame", "bwiki_entity_menu_lab" ] },
      "minecraft:inventory": {
        "container_type": "container",
        "inventory_size": 27,
        "private": false,
        "can_be_siphoned_from": false
      },
      "minecraft:physics": { "has_gravity": false, "has_collision": false },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:damage_sensor": { "triggers": { "cause": "all", "deals_damage": "no" } },
      "minecraft:health": { "value": 1, "max": 1 }
    },
    "events": {
      "minecraft:entity_spawned": { "add": { "component_groups": [ "bwiki:size_m" ] } },
      "bwiki:size_s": {
        "remove": { "component_groups": [ "bwiki:size_m", "bwiki:size_l", "bwiki:size_hit" ] },
        "add": { "component_groups": [ "bwiki:size_s" ] }
      },
      "bwiki:size_m": {
        "remove": { "component_groups": [ "bwiki:size_s", "bwiki:size_l", "bwiki:size_hit" ] },
        "add": { "component_groups": [ "bwiki:size_m" ] }
      },
      "bwiki:size_l": {
        "remove": { "component_groups": [ "bwiki:size_s", "bwiki:size_m", "bwiki:size_hit" ] },
        "add": { "component_groups": [ "bwiki:size_l" ] }
      },
      "bwiki:size_hit": {
        "remove": { "component_groups": [ "bwiki:size_s", "bwiki:size_m", "bwiki:size_l" ] },
        "add": { "component_groups": [ "bwiki:size_hit" ] }
      }
    }
  }
}
