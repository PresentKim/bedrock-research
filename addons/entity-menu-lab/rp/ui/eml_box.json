{
  "namespace": "eml_box",

  "gate": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "container_items" },
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#item_durability_total_amount", "binding_name_override": "#identity" },
      { "binding_type": "view", "source_property_name": "$gate_rule", "target_property_name": "#visible" }
    ]
  },

  "host": {
    "type": "stack_panel", "orientation": "vertical", "size": [ "100%", "100%" ], "collection_name": "container_items",
    "controls": [ { "gate@eml_box.gate": { "collection_index": 0, "controls": [ { "content@$content": {} } ] } } ]
  },

  "root_desktop": {
    "type": "panel", "size": [ "100%", "100%" ],
    "controls": [
      { "vanilla@eml_box.host": { "$gate_rule": "(not (#identity = 4242))", "$content": "chest.small_chest_panel" } },
      { "menu@eml_box.host": { "$gate_rule": "(#identity = 4242)", "$content": "eml_box.window" } }
    ]
  },

  "root_pocket": {
    "type": "panel", "size": [ "100%", "100%" ],
    "controls": [
      { "vanilla@eml_box.host": { "$gate_rule": "(not (#identity = 4242))", "$content": "pocket_containers.small_chest_panel" } },
      { "menu@eml_box.host": { "$gate_rule": "(#identity = 4242)", "$content": "eml_box.window" } }
    ]
  },

  "icon": {
    "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "layer": 2,
    "property_bag": { "#item_id_aux": 0 },
    "bindings": [ { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#item_id_aux", "binding_condition": "always" } ]
  },

  "bound_text": {
    "type": "label", "size": "$text_size", "layer": 3, "localize": false, "color": [ 0.2, 0.2, 0.2 ], "font_scale_factor": 0.7, "text": "#text",
    "$text_size|default": [ 98, 12 ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "$source", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "$rule", "target_property_name": "#text" }
    ]
  },

  "flag_part": {
    "type": "panel", "size": [ 40, 8 ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "$source", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "$rule", "target_property_name": "#visible" }
    ],
    "controls": [
      { "dot": { "type": "image", "texture": "textures/ui/White", "size": [ 8, 8 ], "layer": 3, "color": "$dot_color", "anchor_from": "left_middle", "anchor_to": "left_middle" } },
      { "word": { "type": "label", "layer": 3, "localize": false, "color": [ 0.2, 0.2, 0.2 ], "font_scale_factor": 0.7, "text": "$word", "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [ 10, 0 ] } }
    ]
  },

  "flag": {
    "type": "stack_panel", "orientation": "horizontal", "size": [ 98, 8 ],
    "controls": [
      { "yes@eml_box.flag_part": { "$rule": "$yes_rule", "$dot_color": [ 0.1, 0.75, 0.2 ], "$word": "$yes_word" } },
      { "no@eml_box.flag_part": { "$rule": "$no_rule", "$dot_color": [ 0.85, 0.15, 0.15 ], "$word": "$no_word" } }
    ]
  },

  "bound_texture": {
    "type": "image", "size": [ 10, 10 ], "layer": 3,
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "source_property_name": "$rule", "target_property_name": "#texture" }
    ]
  },

  "bound_bar": {
    "type": "panel", "size": [ 98, 6 ],
    "controls": [
      { "back": { "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ], "layer": 3, "color": [ 0.45, 0.45, 0.45 ] } },
      {
        "fill": {
          "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ], "layer": 4, "color": [ 0.1, 0.75, 0.2 ],
          "clip_direction": "left", "clip_pixelperfect": false,
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
            { "binding_type": "view", "source_property_name": "$rule", "target_property_name": "#clip_ratio" }
          ]
        }
      }
    ]
  },

  "line": {
    "type": "stack_panel", "orientation": "horizontal", "size": "$line_size", "collection_name": "container_items",
    "$line_size|default": [ 160, 12 ],
    "$caption_size|default": [ 62, 12 ],
    "controls": [
      { "caption": { "type": "label", "size": "$caption_size", "layer": 3, "localize": false, "color": [ 0.35, 0.35, 0.35 ], "font_scale_factor": 0.7, "text": "$caption" } },
      { "value@$value": { "collection_index": "$index" } }
    ]
  },

  "cell_off": {
    "type": "panel", "size": [ "100%", "100%" ],
    "controls": [
      { "bg": { "type": "image", "texture": "textures/ui/cell_image", "size": [ "100%", "100%" ] } },
      { "icon@eml_box.icon": {} }
    ]
  },

  "cell_on": {
    "type": "panel", "size": [ "100%", "100%" ],
    "controls": [
      { "bg": { "type": "image", "texture": "textures/ui/cell_image", "size": [ "100%", "100%" ] } },
      { "icon@eml_box.icon": {} },
      { "sel": { "type": "image", "layer": 4, "texture": "textures/ui/focus_border_white", "size": [ "100%", "100%" ], "color": [ 1, 0.85, 0.1 ] } },
      {
        "detail": {
          "type": "panel", "size": [ 80, 86 ], "layer": 20, "anchor_from": "top_left", "anchor_to": "top_left", "offset": "$detail_offset",
          "controls": [
            {
              "frame": {
                "type": "panel", "size": [ 52, 52 ], "anchor_from": "top_left", "anchor_to": "top_left",
                "controls": [
                  { "bg": { "type": "image", "texture": "textures/ui/cell_image", "size": [ "100%", "100%" ] } },
                  { "big@eml_box.icon": { "size": [ 44, 44 ] } }
                ]
              }
            },
            {
              "name@eml_box.bound_text": {
                "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 0, 56 ],
                "$text_size": [ 80, 30 ], "$source": "#hover_text", "$rule": "#hover_text"
              }
            }
          ]
        }
      }
    ]
  },

  "cell": {
    "type": "toggle",
    "size": [ 18, 18 ],
    "layer": 1,
    "focus_enabled": false,
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "toggle_name": "eml_box_items",
    "radio_toggle_group": true,
    "toggle_group_forced_index": "$k",
    "toggle_group_default_selected": -1,
    "toggle_on_button": "toggle.toggle_on",
    "toggle_off_button": "toggle.toggle_off",
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.menu_select", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.menu_ok", "mapping_type": "focused" }
    ],
    "checked_control": "on",
    "checked_hover_control": "on",
    "checked_locked_control": "on",
    "checked_locked_hover_control": "on",
    "unchecked_control": "off",
    "unchecked_hover_control": "off",
    "unchecked_locked_control": "off",
    "unchecked_locked_hover_control": "off",
    "controls": [
      { "on@eml_box.cell_on": {} },
      { "off@eml_box.cell_off": {} }
    ]
  },

  "press_face": {
    "type": "panel", "size": [ "100%", "100%" ],
    "controls": [
      { "bg": { "type": "image", "texture": "$face_texture", "size": [ "100%", "100%" ] } },
      { "label": { "type": "label", "layer": 2, "localize": false, "color": [ 1, 1, 1 ], "shadow": true, "font_scale_factor": 0.8, "text": "Press: rename slot 12" } }
    ]
  },

  "press_button": {
    "type": "button",
    "size": [ 144, 18 ],
    "layer": 2,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "container_items" } ],
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.container_auto_place", "mapping_type": "pressed", "consume_event": false },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.container_auto_place", "mapping_type": "focused", "consume_event": false }
    ],
    "controls": [
      { "default@eml_box.press_face": { "$face_texture": "textures/ui/button_borderless_dark" } },
      { "hover@eml_box.press_face": { "$face_texture": "textures/ui/button_borderless_darkhover" } },
      { "pressed@eml_box.press_face": { "$face_texture": "textures/ui/button_borderless_darkpressed" } }
    ]
  },

  "row": {
    "type": "stack_panel", "orientation": "horizontal", "size": [ 144, 18 ], "collection_name": "container_items"
  },

  "window": {
    "type": "image",
    "texture": "textures/ui/dialog_background_opaque",
    "size": [ 262, 196 ],
    "layer": 2,
    "controls": [
      { "title": { "type": "label", "layer": 3, "localize": false, "color": [ 0.25, 0.25, 0.25 ], "text": "Entity Menu Lab", "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 6 ] } },
      { "close@common.close_button": {} },
      {
        "cells": {
          "type": "panel", "size": [ 144, 18 ], "offset": [ 8, 20 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1,
          "controls": [
            {
              "r0@eml_box.row": {
                "controls": [
                  { "c1@eml_box.cell": { "collection_index": 1, "$k": 0, "$detail_offset": [ 166, 0 ] } },
                  { "c2@eml_box.cell": { "collection_index": 2, "$k": 1, "$detail_offset": [ 148, 0 ] } },
                  { "c3@eml_box.cell": { "collection_index": 3, "$k": 2, "$detail_offset": [ 130, 0 ] } },
                  { "c4@eml_box.cell": { "collection_index": 4, "$k": 3, "$detail_offset": [ 112, 0 ] } },
                  { "c5@eml_box.cell": { "collection_index": 5, "$k": 4, "$detail_offset": [ 94, 0 ] } },
                  { "c6@eml_box.cell": { "collection_index": 6, "$k": 5, "$detail_offset": [ 76, 0 ] } },
                  { "c7@eml_box.cell": { "collection_index": 7, "$k": 6, "$detail_offset": [ 58, 0 ] } },
                  { "c8@eml_box.cell": { "collection_index": 8, "$k": 7, "$detail_offset": [ 40, 0 ] } }
                ]
              }
            }
          ]
        }
      },
      {
        "lines": {
          "type": "stack_panel", "orientation": "vertical", "size": [ 160, 140 ], "offset": [ 8, 42 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1,
          "controls": [
            { "l12@eml_box.line": { "$caption": "Slot 12 raw", "$index": 12, "$value": "eml_box.bound_text", "$source": "#hover_text", "$rule": "#hover_text" } },
            { "l12s@eml_box.line": { "$caption": "Slot 12 stripped", "$index": 12, "$value": "eml_box.bound_text", "$source": "#hover_text", "$rule": "(#hover_text - '§o' - '§f' - '§r')" } },
            { "l13@eml_box.line": { "$caption": "Slot 13 raw", "$index": 13, "$line_size": [ 160, 22 ], "$caption_size": [ 62, 22 ], "$text_size": [ 98, 22 ], "$value": "eml_box.bound_text", "$source": "#hover_text", "$rule": "#hover_text" } },
            { "l14@eml_box.line": { "$caption": "Slot 14 gate", "$index": 14, "$value": "eml_box.flag", "$source": "#hover_text", "$yes_rule": "(not ((#hover_text - 'STATE_ON') = #hover_text))", "$no_rule": "((#hover_text - 'STATE_ON') = #hover_text)", "$yes_word": "ON", "$no_word": "OFF" } },
            { "l15@eml_box.line": { "$caption": "Slot 15 texture", "$index": 15, "$value": "eml_box.bound_texture", "$rule": "('textures/blocks/wool_colored_' + (#hover_text - '§o' - '§f' - '§r'))" } },
            { "l16@eml_box.line": { "$caption": "Slot 16 bar", "$index": 16, "$line_size": [ 160, 10 ], "$caption_size": [ 62, 10 ], "$value": "eml_box.bound_bar", "$rule": "((10 - ((#hover_text - '§o' - '§f' - '§r') * 1)) / 10)" } },
            { "lmax@eml_box.line": { "$caption": "Marker max", "$index": 0, "$value": "eml_box.bound_text", "$source": "#item_durability_max", "$rule": "('' + #item_durability_max)" } },
            { "lmaxg@eml_box.line": { "$caption": "Max = 4242", "$index": 0, "$value": "eml_box.flag", "$source": "#item_durability_max", "$yes_rule": "(#item_durability_max = 4242)", "$no_rule": "(not (#item_durability_max = 4242))", "$yes_word": "yes", "$no_word": "no" } },
            { "ltot@eml_box.line": { "$caption": "Marker total", "$index": 0, "$value": "eml_box.bound_text", "$source": "#item_durability_total_amount", "$rule": "('' + #item_durability_total_amount)" } },
            { "lcur@eml_box.line": { "$caption": "Marker current", "$index": 0, "$value": "eml_box.bound_text", "$source": "#item_durability_current_amount", "$rule": "('' + #item_durability_current_amount)" } }
          ]
        }
      },
      {
        "side": {
          "type": "stack_panel", "orientation": "vertical", "size": [ 82, 24 ], "offset": [ 174, 112 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1,
          "controls": [
            { "r15@eml_box.line": { "$line_size": [ 82, 12 ], "$caption_size": [ 30, 12 ], "$text_size": [ 52, 12 ], "$caption": "15 raw", "$index": 15, "$value": "eml_box.bound_text", "$source": "#hover_text", "$rule": "#hover_text" } },
            { "r16@eml_box.line": { "$line_size": [ 82, 12 ], "$caption_size": [ 30, 12 ], "$text_size": [ 52, 12 ], "$caption": "16 raw", "$index": 16, "$value": "eml_box.bound_text", "$source": "#hover_text", "$rule": "#hover_text" } }
          ]
        }
      },
      {
        "press": {
          "type": "stack_panel", "orientation": "horizontal", "size": [ 144, 18 ], "offset": [ 8, 172 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 1,
          "collection_name": "container_items",
          "controls": [ { "button@eml_box.press_button": { "collection_index": 26 } } ]
        }
      }
    ]
  }
}
