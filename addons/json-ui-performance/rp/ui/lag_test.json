{
  "namespace": "lag",

  "face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$bg_texture|default": "textures/ui/button_borderless_light",
    "$text_cond|default": "always",
    "$icon_layer|default": 0,
    "$label_layer|default": 0,
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "$bg_texture",
          "size": [ "100% - 2px", "100% - 2px" ],
          "color": "$tint"
        }
      },
      {
        "icon": {
          "type": "image",
          "layer": "$icon_layer",
          "size": [ 16, 16 ],
          "offset": [ 3, 3 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture"
            }
          ]
        }
      },
      {
        "name": {
          "type": "label",
          "layer": "$label_layer",
          "size": [ 76, 10 ],
          "offset": [ 22, 3 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "color": [ 0.1, 0.1, 0.1 ],
          "localize": false,
          "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "$text_cond" },
            { "binding_type": "view", "binding_condition": "$text_cond", "source_property_name": "('%.12s' * #form_button_text)", "target_property_name": "#text" }
          ]
        }
      },
      {
        "desc": {
          "type": "label",
          "layer": "$label_layer",
          "size": [ 76, 8 ],
          "offset": [ 22, 13 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "font_scale_factor": 0.7,
          "color": [ 0.3, 0.3, 0.3 ],
          "localize": false,
          "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "$text_cond" },
            { "binding_type": "view", "binding_condition": "$text_cond", "source_property_name": "(('%.32s' * #form_button_text) - ('%.12s' * #form_button_text))", "target_property_name": "#text" }
          ]
        }
      },
      {
        "bar_bg": {
          "type": "image",
          "texture": "textures/ui/empty_progress_bar",
          "size": [ 76, 3 ],
          "offset": [ 22, 24 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "bar": {
          "type": "image",
          "texture": "textures/ui/filled_progress_bar",
          "size": [ 76, 3 ],
          "offset": [ 22, 24 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "clip_direction": "left",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" },
            { "binding_type": "view", "source_property_name": "(1 - (((#form_button_text - ('%.32s' * #form_button_text)) * 1) / 100))", "target_property_name": "#clip_ratio" }
          ]
        }
      }
    ]
  },

  "cell@common.button": {
    "size": [ 100, 30 ],
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
    ],
    "controls": [
      { "default@lag.face": {} },
      { "hover@lag.face": { "$bg_texture": "textures/ui/button_borderless_lighthover" } },
      { "pressed@lag.face": { "$bg_texture": "textures/ui/button_borderless_lightpressed" } }
    ]
  },

  "face_raw": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$bg_texture|default": "textures/ui/button_borderless_light",
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "$bg_texture",
          "size": [ "100% - 2px", "100% - 2px" ],
          "color": "$tint"
        }
      },
      {
        "icon": {
          "type": "image",
          "size": [ 16, 16 ],
          "offset": [ 3, 3 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_texture", "binding_name_override": "#texture" }
          ]
        }
      },
      {
        "raw": {
          "type": "label",
          "size": [ 76, 20 ],
          "offset": [ 22, 3 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "font_scale_factor": 0.7,
          "color": [ 0.1, 0.1, 0.1 ],
          "localize": false,
          "text": "#form_button_text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" }
          ]
        }
      },
      {
        "bar_bg": {
          "type": "image",
          "texture": "textures/ui/empty_progress_bar",
          "size": [ 76, 3 ],
          "offset": [ 22, 24 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "bar": {
          "type": "image",
          "texture": "textures/ui/filled_progress_bar",
          "size": [ 76, 3 ],
          "offset": [ 22, 24 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "clip_direction": "left",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" },
            { "binding_type": "view", "source_property_name": "(1 - (((#form_button_text - ('%.32s' * #form_button_text)) * 1) / 100))", "target_property_name": "#clip_ratio" }
          ]
        }
      }
    ]
  },

  "cell_layered@lag.cell": {
    "$icon_layer": 2,
    "$label_layer": 3
  },

  "cell_raw@lag.cell": {
    "controls": [
      { "default@lag.face_raw": {} },
      { "hover@lag.face_raw": { "$bg_texture": "textures/ui/button_borderless_lighthover" } },
      { "pressed@lag.face_raw": { "$bg_texture": "textures/ui/button_borderless_lightpressed" } }
    ]
  },

  "cell_vis@lag.cell": {
    "$text_cond": "visible"
  },

  "grid": {
    "type": "grid",
    "size": [ 204, "100%c" ],
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "lag.cell",
    "collection_name": "form_buttons",
    "bindings": [
      { "binding_name": "#form_button_length", "binding_name_override": "#maximum_grid_items", "binding_condition": "always" }
    ]
  },

  "grid_raw@lag.grid": { "grid_item_template": "lag.cell_raw" },
  "grid_vis@lag.grid": { "grid_item_template": "lag.cell_vis" },
  "grid_layered@lag.grid": { "grid_item_template": "lag.cell_layered" },

  "stack_list": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 204, "100%c" ],
    "collection_name": "form_buttons",
    "factory": { "name": "lag_stack_list", "control_ids": { "button": "@lag.cell" } },
    "bindings": [
      { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length", "binding_condition": "always" }
    ]
  },

  "nudge_grow": {
    "anim_type": "size",
    "easing": "linear",
    "duration": 0.05,
    "from": [ 1, 1 ],
    "to": [ 1, 2 ]
  },

  "nudge_wait": {
    "anim_type": "wait",
    "duration": 1.0,
    "next": "@lag.nudge_grow"
  },

  "nudge": {
    "type": "panel",
    "size": [ 1, 1 ],
    "anims": [ "@lag.nudge_wait" ]
  },

  "no_nudge": {
    "type": "panel",
    "size": [ 0, 0 ]
  },

  "layout": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "$tint|default": [ 1, 1, 1 ],
    "$head|default": "레이아웃",
    "$list_def|default": "lag.grid",
    "$nudge_def|default": "lag.no_nudge",
    "controls": [
      { "head": { "type": "label", "text": "$head", "localize": false, "color": [ 0.4, 1, 0.4 ] } },
      { "nudge@$nudge_def": {} },
      { "list@$list_def": {} }
    ]
  },

  "layout_v@lag.layout": {
    "$vis|default": "(#title_text = 'none')",
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "$vis", "target_property_name": "#visible" }
    ]
  },

  "v_body": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "controls": [
      { "l1@lag.layout_v": { "$tint": [ 1, 0.8, 0.8 ], "$head": "V/X: 레이아웃 1 (6개 모두 생성)", "$vis": "(('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'a')" } },
      { "l2@lag.layout_v": { "$tint": [ 0.8, 1, 0.8 ], "$head": "V/X: 레이아웃 2 (6개 모두 생성)", "$vis": "(('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'b')" } },
      { "l3@lag.layout_v": { "$tint": [ 0.8, 0.8, 1 ], "$head": "V/X: 레이아웃 3 (6개 모두 생성)", "$vis": "(('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'c')" } },
      { "l4@lag.layout_v": { "$tint": [ 1, 1, 0.7 ], "$head": "V/X: 레이아웃 4 (6개 모두 생성)", "$vis": "(('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'd')" } },
      { "l5@lag.layout_v": { "$tint": [ 1, 0.8, 1 ], "$head": "V/X: 레이아웃 5 (6개 모두 생성)", "$vis": "(('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'e')" } },
      { "l6@lag.layout_v": { "$tint": [ 0.8, 1, 1 ], "$head": "V/X: 레이아웃 6 (6개 모두 생성)", "$vis": "(('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'f')" } }
    ]
  },

  "mode_v": {
    "type": "collection_panel",
    "size": [ "100%", "100%c" ],
    "factory": {
      "name": "lag_mode_v",
      "control_ids": { "v": "@lag.v_body", "va": "@lag.v_body_raw", "vb": "@lag.v_body_vis", "vc": "@lag.v_body_nudge", "vq": "@lag.v_body_layered" }
    },
    "property_bag": { "#lag:V": [ "v" ], "#lag:X": [ "v" ], "#lag:A": [ "va" ], "#lag:B": [ "vb" ], "#lag:C": [ "vc" ], "#lag:Q": [ "vq" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.5s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "g_gate_1": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 1, 0.8, 0.8 ], "$head": "G/Y: 레이아웃 1 (고른 것만 생성)",
    "factory": { "name": "lag_g1", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'a') * 1)", "target_property_name": "#collection_length" } ]
  },
  "g_gate_2": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 0.8, 1, 0.8 ], "$head": "G/Y: 레이아웃 2 (고른 것만 생성)",
    "factory": { "name": "lag_g2", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'b') * 1)", "target_property_name": "#collection_length" } ]
  },
  "g_gate_3": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 0.8, 0.8, 1 ], "$head": "G/Y: 레이아웃 3 (고른 것만 생성)",
    "factory": { "name": "lag_g3", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'c') * 1)", "target_property_name": "#collection_length" } ]
  },
  "g_gate_4": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 1, 1, 0.7 ], "$head": "G/Y: 레이아웃 4 (고른 것만 생성)",
    "factory": { "name": "lag_g4", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'd') * 1)", "target_property_name": "#collection_length" } ]
  },
  "g_gate_5": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 1, 0.8, 1 ], "$head": "G/Y: 레이아웃 5 (고른 것만 생성)",
    "factory": { "name": "lag_g5", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'e') * 1)", "target_property_name": "#collection_length" } ]
  },
  "g_gate_6": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 0.8, 1, 1 ], "$head": "G/Y: 레이아웃 6 (고른 것만 생성)",
    "factory": { "name": "lag_g6", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.1s' * (#title_text - ('%.5s' * #title_text))) = 'f') * 1)", "target_property_name": "#collection_length" } ]
  },

  "g_body": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "controls": [
      { "g1@lag.g_gate_1": {} },
      { "g2@lag.g_gate_2": {} },
      { "g3@lag.g_gate_3": {} },
      { "g4@lag.g_gate_4": {} },
      { "g5@lag.g_gate_5": {} },
      { "g6@lag.g_gate_6": {} }
    ]
  },

  "mode_g": {
    "type": "collection_panel",
    "size": [ "100%", "100%c" ],
    "factory": {
      "name": "lag_mode_g",
      "control_ids": { "g": "@lag.g_body", "gf": "@lag.g_body_stack", "gh": "@lag.g_body_raw", "gi": "@lag.g_body_layered" }
    },
    "property_bag": { "#lag:G": [ "g" ], "#lag:Y": [ "g" ], "#lag:F": [ "gf" ], "#lag:H": [ "gh" ], "#lag:I": [ "gi" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.5s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "v_body_raw@lag.v_body": { "$list_def": "lag.grid_raw" },
  "v_body_vis@lag.v_body": { "$list_def": "lag.grid_vis" },
  "v_body_nudge@lag.v_body": { "$nudge_def": "lag.nudge" },
  "g_body_stack@lag.g_body": { "$list_def": "lag.stack_list" },
  "g_body_raw@lag.g_body": { "$list_def": "lag.grid_raw" },
  "v_body_layered@lag.v_body": { "$list_def": "lag.grid_layered" },
  "g_body_layered@lag.g_body": { "$list_def": "lag.grid_layered" },

  "screen_gate": {
    "type": "panel",
    "size": [ 216, "90%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 4, 0 ],
    "layer": 60,
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "lag.screen_gate_content",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100% - 2px" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ]
        }
      }
    ]
  },

  "screen_gate_content": {
    "type": "collection_panel",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": { "name": "lag_screen_gate", "control_ids": { "v": "@lag.v_body", "g": "@lag.g_body" } },
    "property_bag": { "#lag:D": [ "v" ], "#lag:E": [ "g" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.5s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "nothing": {
    "type": "panel",
    "size": [ 0, 0 ]
  },

  "consumer_body": {
    "type": "stack_panel",
    "size": [ 0, 0 ],
    "collection_name": "form_buttons",
    "factory": { "name": "lag_consumer", "control_ids": { "button": "@lag.nothing" } },
    "bindings": [
      { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length", "binding_condition": "always" }
    ]
  },

  "consumer": {
    "type": "collection_panel",
    "size": [ 0, 0 ],
    "factory": { "name": "lag_consumer_gate", "control_ids": { "c": "@lag.consumer_body" } },
    "property_bag": { "#lag:X": [ "c" ], "#lag:Y": [ "c" ], "#lag:Z": [ "c" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.5s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "r_layout_1@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "R/Z: 레이아웃 1 (화면 맨 위 라우터)" },
  "r_layout_2@lag.layout": { "$tint": [ 0.8, 1, 0.8 ], "$head": "R/Z: 레이아웃 2 (화면 맨 위 라우터)" },
  "r_layout_3@lag.layout": { "$tint": [ 0.8, 0.8, 1 ], "$head": "R/Z: 레이아웃 3 (화면 맨 위 라우터)" },
  "r_layout_4@lag.layout": { "$tint": [ 1, 1, 0.7 ], "$head": "R/Z: 레이아웃 4 (화면 맨 위 라우터)" },
  "r_layout_5@lag.layout": { "$tint": [ 1, 0.8, 1 ], "$head": "R/Z: 레이아웃 5 (화면 맨 위 라우터)" },
  "r_layout_6@lag.layout": { "$tint": [ 0.8, 1, 1 ], "$head": "R/Z: 레이아웃 6 (화면 맨 위 라우터)" },

  "l_layout@lag.layout": {
    "$tint": [ 1, 0.8, 0.8 ], "$head": "L: R + 레이아웃에 #visible 바인딩",
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(not (#title_text = 'zzz'))", "target_property_name": "#visible" }
    ]
  },

  "m_wrap": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "controls": [
      { "inner@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "M: R + stack_panel 한 겹" } }
    ]
  },

  "n_gate": {
    "type": "stack_panel", "size": [ "100%", "100%c" ],
    "$tint": [ 1, 0.8, 0.8 ], "$head": "N: R + 팩토리 한 겹",
    "factory": { "name": "lag_n", "control_name": "lag.layout" },
    "bindings": [ { "binding_name": "#title_text", "binding_condition": "always" }, { "binding_type": "view", "binding_condition": "always", "source_property_name": "((('%.5s' * #title_text) = 'lag:N') * 1)", "target_property_name": "#collection_length" } ]
  },

  "k_gate": {
    "type": "collection_panel",
    "size": [ "100%", "100%c" ],
    "factory": { "name": "lag_k", "control_ids": { "k": "@lag.k_layout" } },
    "property_bag": { "#lag:Ka": [ "k" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.6s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "k_layout@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "K: R 구조를 long_form 안에" },

  "o_router": {
    "type": "collection_panel",
    "size": [ 210, "90%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 4, 0 ],
    "layer": 60,
    "clips_children": true,
    "factory": { "name": "lag_o", "control_ids": { "o": "@lag.o_layout" } },
    "property_bag": { "#lag:Oa": [ "o" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.6s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "j_layout@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "J: R + 글자 레이어를 배경 위로", "$list_def": "lag.grid_layered" },

  "o_layout@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "O: 스크롤 없는 라우터 (1.5.0 R)" },

  "p_router": {
    "type": "collection_panel",
    "size": [ 216, "90%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 4, 0 ],
    "layer": 60,
    "factory": { "name": "lag_p", "control_ids": { "p": "@lag.p_body" } },
    "property_bag": { "#lag:Pa": [ "p" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.6s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "p_body": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "lag.p_layout",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100% - 2px" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ]
        }
      }
    ]
  },

  "p_layout@lag.layout": { "size": [ "100% - 4px", "100%c" ], "$tint": [ 1, 0.8, 0.8 ], "$head": "P: 팩토리가 스크롤째로 만듦" },

  "t_router@lag.router": { "$router_content": "lag.t_content", "$router_jump": true },
  "u_router@lag.router": { "$router_content": "lag.u_content", "$router_clip": false },

  "t_content": {
    "type": "collection_panel",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": { "name": "lag_t", "control_ids": { "t": "@lag.t_layout" } },
    "property_bag": { "#lag:Ta": [ "t" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.6s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "u_content": {
    "type": "collection_panel",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": { "name": "lag_u", "control_ids": { "u": "@lag.u_layout" } },
    "property_bag": { "#lag:Ua": [ "u" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.6s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  },

  "t_layout@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "T: R + jump_to_bottom_on_update" },
  "u_layout@lag.layout": { "$tint": [ 1, 0.8, 0.8 ], "$head": "U: R + 스크롤 영역 자르기 끔" },

  "w_router@lag.router": {
    "$router_content": "lag.w_layout",
    "visible": false,
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(('%.6s' * #title_text) = 'lag:Wa')", "target_property_name": "#visible" }
    ]
  },

  "w_layout@lag.layout": { "size": [ "100% - 4px", "100%c" ], "$tint": [ 1, 0.8, 0.8 ], "$head": "W: 팩토리 없이 스크롤 안에 바로" },

  "router": {
    "type": "panel",
    "size": [ 216, "90%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 4, 0 ],
    "layer": 60,
    "$router_content|default": "lag.router_content",
    "$router_jump|default": false,
    "$router_clip|default": true,
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$jump_to_bottom_on_update": "$router_jump",
          "$scroll_view_port_clips_children": "$router_clip",
          "$scrolling_content": "$router_content",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100% - 2px" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ]
        }
      }
    ]
  },

  "router_content": {
    "type": "collection_panel",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "lag_router",
      "control_ids": {
        "l1": "@lag.r_layout_1",
        "l2": "@lag.r_layout_2",
        "l3": "@lag.r_layout_3",
        "l4": "@lag.r_layout_4",
        "l5": "@lag.r_layout_5",
        "l6": "@lag.r_layout_6",
        "la": "@lag.l_layout",
        "ma": "@lag.m_wrap",
        "na": "@lag.n_gate",
        "ja": "@lag.j_layout"
      }
    },
    "property_bag": {
      "#lag:Ra": [ "l1" ], "#lag:Rb": [ "l2" ], "#lag:Rc": [ "l3" ],
      "#lag:Rd": [ "l4" ], "#lag:Re": [ "l5" ], "#lag:Rf": [ "l6" ],
      "#lag:Za": [ "l1" ], "#lag:Zb": [ "l2" ], "#lag:Zc": [ "l3" ],
      "#lag:Zd": [ "l4" ], "#lag:Ze": [ "l5" ], "#lag:Zf": [ "l6" ],
      "#lag:La": [ "la" ], "#lag:Ma": [ "ma" ], "#lag:Na": [ "na" ], "#lag:Ja": [ "ja" ]
    },
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "('#' + ('%.6s' * #title_text))",
        "target_property_name": "#collection_length"
      }
    ]
  }
