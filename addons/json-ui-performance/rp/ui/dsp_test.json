{
  "namespace": "dsp",

  "relayout": {
    "anim_type": "size",
    "easing": "linear",
    "duration": 0.05,
    "from": [ 200, 51 ],
    "to": [ 200, 52 ]
  },

  "relayout_late": {
    "anim_type": "wait",
    "duration": 1.0,
    "next": "@dsp.relayout"
  },

  "screen_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "vanilla@server_form.main_screen_content": {} },
      { "router@dsp.router": {} },
      { "lag_router@lag.router": {} },
      { "lag_screen_gate@lag.screen_gate": {} },
      { "lag_o_router@lag.o_router": {} },
      { "lag_p_router@lag.p_router": {} },
      { "lag_t_router@lag.t_router": {} },
      { "lag_u_router@lag.u_router": {} },
      { "lag_w_router@lag.w_router": {} }
    ]
  },

  "router": {
    "type": "collection_panel",
    "size": [ 210, 62 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 4 ],
    "layer": 50,
    "factory": {
      "name": "dsp_router",
      "control_ids": {
        "b": "@dsp.cell_b"
      }
    },
    "property_bag": {
      "#dsp:B": [ "b" ]
    },
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "('#' + ('%.5s' * #title_text))",
        "target_property_name": "#collection_length"
      }
    ]
  },

  "btn_cell": {
    "type": "panel",
    "size": [ 200, 10 ],
    "controls": [
      {
        "t": {
          "type": "label",
          "text": "#form_button_text",
          "localize": false,
          "color": [ 1, 1, 0.5 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            }
          ]
        }
      }
    ]
  },

  "btn_grid": {
    "type": "grid",
    "size": [ 200, 40 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 0, 10 ],
    "grid_dimensions": [ 1, 4 ],
    "grid_item_template": "dsp.btn_cell",
    "grid_fill_direction": "vertical",
    "collection_name": "form_buttons",
    "bindings": [
      { "binding_name": "#form_button_length", "binding_name_override": "#maximum_grid_items" }
    ]
  },

  "cell": {
    "type": "panel",
    "size": [ 200, 52 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$label|default": "생성됨",
    "controls": [
      {
        "ok": {
          "type": "label",
          "text": "$label",
          "localize": false,
          "color": [ 0.4, 1, 0.4 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      { "grid@dsp.btn_grid": {} }
    ]
  },

  "cell_b@dsp.cell": {
    "$label": "B: 생성됨 (화면 맨 위 팩토리)"
  },

  "wait_label": {
    "type": "label",
    "localize": false,
    "color": [ 1, 0.5, 0.5 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  "nested_a": {
    "type": "panel",
    "size": [ 200, 62 ],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:A')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "A: 대기 (아래 초록 글이 없으면 실패)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$label": "A: 생성됨",
          "factory": { "name": "dsp_a", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:A') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_c": {
    "type": "panel",
    "size": [ 200, 62 ],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:C')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "C: 대기 (열 때 크기 애니메이션)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, 52 ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "anims": [ "@dsp.relayout" ],
          "$label": "C: 생성됨",
          "factory": { "name": "dsp_c", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:C') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_d": {
    "type": "panel",
    "size": [ 200, 62 ],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:D')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "D: 대기 (1초 뒤 크기 애니메이션)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, 52 ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "anims": [ "@dsp.relayout_late" ],
          "$label": "D: 생성됨",
          "factory": { "name": "dsp_d", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:D') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_e": {
    "type": "panel",
    "size": [ 200, 62 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#title_text = 'dsp:E')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "E: 대기 (숨김 시작, visible 조건 길이)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$label": "E: 생성됨",
          "factory": { "name": "dsp_e", "control_name": "dsp.cell" },
          "property_bag": { "#one": 1 },
          "bindings": [
            { "binding_type": "view", "binding_condition": "visible", "source_property_name": "#one", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_f": {
    "type": "panel",
    "size": [ 200, 62 ],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:F')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "F: 대기 (#title_text 받아오는 줄 없음)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$label": "F: 생성됨",
          "factory": { "name": "dsp_f", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:F') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_g": {
    "type": "panel",
    "size": [ 200, 62 ],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:G')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "G: 대기 (F + 팩토리 이름 없음, @ 참조)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$label": "G: 생성됨",
          "factory": { "control_name": "@dsp.cell" },
          "bindings": [
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:G') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "cell_h": {
    "type": "panel",
    "size": [ 200, 62 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "outer": {
          "type": "label",
          "text": "H: 바깥 생성됨",
          "localize": false,
          "color": [ 0.4, 0.8, 1 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "inner": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$label": "H: 안쪽 생성됨",
          "factory": { "name": "dsp_h_inner", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_h": {
    "type": "panel",
    "size": [ 200, 74 ],
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:H')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "H: 대기 (팩토리가 만든 칸 안의 팩토리)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "factory": { "name": "dsp_h_outer", "control_name": "dsp.cell_h" },
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "cell_h2": {
    "type": "panel", "size": [ 200, 62 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "outer": { "type": "label", "text": "H2: 바깥 생성됨", "localize": false, "color": [ 0.4, 0.8, 1 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      {
        "inner": {
          "type": "stack_panel", "size": [ 200, "100%c" ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "$label": "H2: 안쪽 생성됨",
          "factory": { "name": "dsp_h2_inner", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_name": "#title_text", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "((#title_text = 'dsp:H2') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "cell_h3": {
    "type": "panel", "size": [ 200, 62 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "outer": { "type": "label", "text": "H3: 바깥 생성됨", "localize": false, "color": [ 0.4, 0.8, 1 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      {
        "inner": {
          "type": "stack_panel", "size": [ 200, "100%c" ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "$label": "H3: 안쪽 생성됨",
          "factory": { "name": "dsp_h3_inner", "control_name": "dsp.cell" },
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "dsp_h3_source",
              "resolve_ancestor_scope": true,
              "source_property_name": "#h3_length",
              "target_property_name": "#collection_length"
            }
          ]
        }
      }
    ]
  },

  "cell_h4": {
    "type": "panel", "size": [ 200, 62 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "outer": { "type": "label", "text": "H4: 바깥 생성됨 (안쪽은 grid)", "localize": false, "color": [ 0.4, 0.8, 1 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      { "inner_grid@dsp.btn_grid": {} }
    ]
  },

  "cell_h5": {
    "type": "panel", "size": [ 200, 62 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "outer": { "type": "label", "text": "H5: 바깥 생성됨", "localize": false, "color": [ 0.4, 0.8, 1 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      {
        "inner": {
          "type": "stack_panel", "size": [ 200, 52 ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "anims": [ "@dsp.relayout_late" ],
          "$label": "H5: 안쪽 생성됨",
          "factory": { "name": "dsp_h5_inner", "control_name": "dsp.cell" },
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H5') * 1)", "target_property_name": "#collection_length" }
          ]
        }
      }
    ]
  },

  "nested_h2": {
    "type": "panel", "size": [ 200, 74 ],
    "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:H2')", "target_property_name": "#visible" } ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "H2: 대기 (안쪽 길이 바인딩 always)" } },
      {
        "host": {
          "type": "stack_panel", "size": [ 200, "100%c" ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "factory": { "name": "dsp_h2_outer", "control_name": "dsp.cell_h2" },
          "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H2') * 1)", "target_property_name": "#collection_length" } ]
        }
      }
    ]
  },

  "nested_h3": {
    "type": "panel", "size": [ 200, 74 ],
    "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:H3')", "target_property_name": "#visible" } ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "H3: 대기 (안쪽 길이를 바깥 데이터 소스에서)" } },
      {
        "dsp_h3_source": {
          "type": "panel", "size": [ 0, 0 ],
          "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H3') * 1)", "target_property_name": "#h3_length" } ]
        }
      },
      {
        "host": {
          "type": "stack_panel", "size": [ 200, "100%c" ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "factory": { "name": "dsp_h3_outer", "control_name": "dsp.cell_h3" },
          "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H3') * 1)", "target_property_name": "#collection_length" } ]
        }
      }
    ]
  },

  "nested_h4": {
    "type": "panel", "size": [ 200, 74 ],
    "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:H4')", "target_property_name": "#visible" } ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "H4: 대기 (안쪽을 grid로)" } },
      {
        "host": {
          "type": "stack_panel", "size": [ 200, "100%c" ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "factory": { "name": "dsp_h4_outer", "control_name": "dsp.cell_h4" },
          "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H4') * 1)", "target_property_name": "#collection_length" } ]
        }
      }
    ]
  },

  "nested_h5": {
    "type": "panel", "size": [ 200, 74 ],
    "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "(#title_text = 'dsp:H5')", "target_property_name": "#visible" } ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "H5: 대기 (안쪽에 1초 뒤 크기 애니메이션)" } },
      {
        "host": {
          "type": "stack_panel", "size": [ 200, "100%c" ], "offset": [ 0, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "factory": { "name": "dsp_h5_outer", "control_name": "dsp.cell_h5" },
          "bindings": [ { "binding_name": "#title_text" }, { "binding_type": "view", "source_property_name": "((#title_text = 'dsp:H5') * 1)", "target_property_name": "#collection_length" } ]
        }
      }
    ]
  },

  "row_i": {
    "type": "panel",
    "size": [ 200, 10 ],
    "controls": [
      {
        "t": {
          "type": "label",
          "text": "#form_button_text",
          "localize": false,
          "color": [ 0.4, 1, 0.4 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_name": "#form_button_text"
            }
          ]
        }
      }
    ]
  },

  "nested_i": {
    "type": "panel",
    "size": [ 200, 52 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#title_text = 'dsp:I')", "target_property_name": "#visible" }
    ],
    "controls": [
      { "wait@dsp.wait_label": { "text": "I: 대기 (숨김 시작, 버튼 목록 길이에 visible 조건)" } },
      {
        "host": {
          "type": "stack_panel",
          "size": [ 200, "100%c" ],
          "offset": [ 0, 10 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "collection_name": "form_buttons",
          "factory": { "name": "dsp_i", "control_ids": { "button": "@dsp.row_i" } },
          "bindings": [
            { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length", "binding_condition": "visible" }
          ]
        }
      }
    ]
  }
}
