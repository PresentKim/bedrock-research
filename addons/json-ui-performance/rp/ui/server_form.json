{
  "namespace": "server_form",

  "third_party_server_screen": {
    "$screen_content": "dsp.screen_root"
  },

  "long_form_scrolling_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "dsp_nested_a@dsp.nested_a": {} },
          { "dsp_nested_c@dsp.nested_c": {} },
          { "dsp_nested_d@dsp.nested_d": {} },
          { "dsp_nested_e@dsp.nested_e": {} },
          { "dsp_nested_f@dsp.nested_f": {} },
          { "dsp_nested_g@dsp.nested_g": {} },
          { "dsp_nested_h@dsp.nested_h": {} },
          { "dsp_nested_h2@dsp.nested_h2": {} },
          { "dsp_nested_h3@dsp.nested_h3": {} },
          { "dsp_nested_h4@dsp.nested_h4": {} },
          { "dsp_nested_h5@dsp.nested_h5": {} },
          { "dsp_nested_i@dsp.nested_i": {} },
          { "lag_mode_v@lag.mode_v": {} },
          { "lag_mode_g@lag.mode_g": {} },
          { "lag_k_gate@lag.k_gate": {} },
          { "lag_consumer@lag.consumer": {} }
        ]
      }
    ]
  },

  "long_form_scrolling_content/wrapping_panel": {
    "visible": false,
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "(not ((('%.4s' * #title_text) = 'lag:') and not (('%.5s' * #title_text) = 'lag:S')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "long_form_dynamic_buttons_panel": {
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  }
}
