{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.re4.ctx": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [ "snd_base" ],
          "transitions": [
            { "hidden": "context.is_hidden" },
            { "moving": "context.move_distance > 0" }
          ]
        },
        "hidden": {
          "animations": [ "snd_hidden" ],
          "transitions": [ { "default": "!context.is_hidden" } ]
        },
        "moving": {
          "animations": [ "snd_move" ],
          "transitions": [ { "default": "context.move_distance <= 0" } ]
        }
      }
    }
  }
}
