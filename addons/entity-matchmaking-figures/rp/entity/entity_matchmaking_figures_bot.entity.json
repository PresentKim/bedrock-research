{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bwiki:entity_matchmaking_figures_bot",
      "materials": { "default": "entity_alphatest" },
      "textures": { "steve": "textures/entity/steve", "alex": "textures/entity/alex" },
      "geometry": { "classic": "geometry.humanoid.custom", "slim": "geometry.humanoid.customSlim" },
      "animations": {
        "look_around": "animation.emf.look_around"
      },
      "scripts": {
        "initialize": [
          "v.body_yaw = 0.0;",
          "v.head_yaw = 0.0;",
          "v.head_pitch = 0.0;"
        ],
        "pre_animation": [
          "v.body_yaw = v.body_yaw + (q.property('bwiki:yaw') - v.body_yaw) * math.min(1.0, q.delta_time * 1.5);",
          "v.head_yaw = v.head_yaw + (q.property('bwiki:head_yaw') - v.head_yaw) * math.min(1.0, q.delta_time * 4.0);",
          "v.head_pitch = v.head_pitch + (q.property('bwiki:pitch') - v.head_pitch) * math.min(1.0, q.delta_time * 4.0);"
        ],
        "animate": [ "look_around" ]
      },
      "render_controllers": [ "controller.render.bwiki.entity_matchmaking_figures_bot" ]
    }
  }
}
