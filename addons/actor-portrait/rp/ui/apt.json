{
  "namespace": "apt",

  "backdrop": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.5,
    "size": [ "100%", "100%" ],
    "layer": 1
  },

  "caption": {
    "type": "label",
    "color": [ 1, 1, 1 ],
    "font_scale_factor": 0.75,
    "shadow": true,
    "localize": false,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -1 ],
    "layer": 3
  },

  "portrait": {
    "type": "custom",
    "renderer": "actor_portrait_renderer",
    "size": [ "100%", "100% - 9px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "enable_scissor_test": true,
    "layer": 2
  },

  "cell": {
    "type": "panel",
    "size": [ 44, 72 ],
    "$apt_id|default": 0,
    "variables": [
      { "requires": "($subtitle_text = '-4294967295')", "$apt_id": -4294967295 },
      { "requires": "($subtitle_text = '-8589934591')", "$apt_id": -8589934591 },
      { "requires": "($subtitle_text = '-12884901887')", "$apt_id": -12884901887 },
      { "requires": "($subtitle_text = '-17179869183')", "$apt_id": -17179869183 },
      { "requires": "($subtitle_text = '-21474836479')", "$apt_id": -21474836479 },
      { "requires": "($subtitle_text = '-25769803775')", "$apt_id": -25769803775 },
      { "requires": "($subtitle_text = '-30064771071')", "$apt_id": -30064771071 },
      { "requires": "($subtitle_text = '-34359738367')", "$apt_id": -34359738367 },
      { "requires": "($subtitle_text = '-38654705663')", "$apt_id": -38654705663 },
      { "requires": "($subtitle_text = '-42949672959')", "$apt_id": -42949672959 },
      { "requires": "($subtitle_text = '-47244640255')", "$apt_id": -47244640255 },
      { "requires": "($subtitle_text = '-51539607551')", "$apt_id": -51539607551 },
      { "requires": "($subtitle_text = '-55834574847')", "$apt_id": -55834574847 },
      { "requires": "($subtitle_text = '-60129542143')", "$apt_id": -60129542143 },
      { "requires": "($subtitle_text = '-64424509439')", "$apt_id": -64424509439 },
      { "requires": "($subtitle_text = '-68719476735')", "$apt_id": -68719476735 },
      { "requires": "($subtitle_text = '-73014444031')", "$apt_id": -73014444031 },
      { "requires": "($subtitle_text = '-77309411327')", "$apt_id": -77309411327 },
      { "requires": "($subtitle_text = '-81604378623')", "$apt_id": -81604378623 },
      { "requires": "($subtitle_text = '-85899345919')", "$apt_id": -85899345919 },
      { "requires": "($subtitle_text = '-90194313215')", "$apt_id": -90194313215 },
      { "requires": "($subtitle_text = '-94489280511')", "$apt_id": -94489280511 },
      { "requires": "($subtitle_text = '-98784247807')", "$apt_id": -98784247807 },
      { "requires": "($subtitle_text = '-103079215103')", "$apt_id": -103079215103 },
      { "requires": "($subtitle_text = '-107374182399')", "$apt_id": -107374182399 },
      { "requires": "($subtitle_text = '-111669149695')", "$apt_id": -111669149695 },
      { "requires": "($subtitle_text = '-115964116991')", "$apt_id": -115964116991 },
      { "requires": "($subtitle_text = '-120259084287')", "$apt_id": -120259084287 },
      { "requires": "($subtitle_text = '-124554051583')", "$apt_id": -124554051583 },
      { "requires": "($subtitle_text = '-128849018879')", "$apt_id": -128849018879 },
      { "requires": "($subtitle_text = '-133143986175')", "$apt_id": -133143986175 },
      { "requires": "($subtitle_text = '-137438953471')", "$apt_id": -137438953471 }
    ]
  },

  "panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 72 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 4, 4 ],
    "layer": 30,
    "ignored": "(not ($title_text = 'apt'))",
    "controls": [
      {
        "still@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": "$apt_id" } } },
            { "label@apt.caption": { "text": "Still" } }
          ]
        }
      },
      {
        "auto@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": "$apt_id", "rotate_mode": "auto" } } },
            { "label@apt.caption": { "text": "Auto" } }
          ]
        }
      },
      {
        "back@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": "$apt_id", "scale_x": 0.5, "scale_y": 0.5, "scale_z": 0.5, "rotate_y": 180 } } },
            { "label@apt.caption": { "text": "Back" } }
          ]
        }
      },
      {
        "tilt@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": "$apt_id", "rotate_x": 45 } } },
            { "label@apt.caption": { "text": "Tilt" } }
          ]
        }
      }
    ]
  }
}
