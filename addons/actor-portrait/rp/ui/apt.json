{
  "namespace": "apt",

  "backdrop": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.5,
    "size": [ "100%", "100%" ],
    "layer": 1
  },

  "caption": {
    "type": "label",
    "color": [ 1, 1, 1 ],
    "font_scale_factor": 0.75,
    "shadow": true,
    "localize": false,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -1 ],
    "layer": 3
  },

  "portrait": {
    "type": "custom",
    "renderer": "actor_portrait_renderer",
    "size": [ "100%", "100% - 9px" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "enable_scissor_test": true,
    "layer": 2
  },

  "cell": {
    "type": "panel",
    "size": [ 44, 72 ]
  },

  "panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 72 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 4, 4 ],
    "layer": 30,
    "ignored": "(not ($title_text = 'apt'))",
    "controls": [
      {
        "still@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": -4294967295 } } },
            { "label@apt.caption": { "text": "Still" } }
          ]
        }
      },
      {
        "auto@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": -4294967295, "rotate_mode": "auto" } } },
            { "label@apt.caption": { "text": "Auto" } }
          ]
        }
      },
      {
        "back@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": -4294967295, "scale_x": 0.5, "scale_y": 0.5, "scale_z": 0.5, "rotate_y": 180 } } },
            { "label@apt.caption": { "text": "Back" } }
          ]
        }
      },
      {
        "tilt@apt.cell": {
          "controls": [
            { "backdrop@apt.backdrop": {} },
            { "model@apt.portrait": { "property_bag": { "actor_id": -4294967295, "rotate_x": 45 } } },
            { "label@apt.caption": { "text": "Tilt" } }
          ]
        }
      }
    ]
  }
}
