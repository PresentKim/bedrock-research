{
  "namespace": "cvo",

  "bg_image": {
    "type": "image",
    "texture": "$bg_texture",
    "size": [ "100% - 2px", "100% - 2px" ]
  },

  "icon_image": {
    "type": "image", "layer": 2, "size": [ 16, 16 ], "offset": [ 3, 3 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "bindings": [ { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_texture", "binding_name_override": "#texture" } ]
  },

  "bar_bg_image": {
    "type": "image", "layer": 2, "texture": "textures/ui/empty_progress_bar", "size": [ 76, 3 ], "offset": [ 22, 24 ], "anchor_from": "top_left", "anchor_to": "top_left"
  },

  "face_always": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$bg_texture|default": "textures/ui/button_borderless_light",
    "controls": [
      { "bg@cvo.bg_image": {} },
      { "icon@cvo.icon_image": {} },
      {
        "name": {
          "type": "label", "layer": 3, "size": [ 76, 10 ], "offset": [ 22, 3 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "color": [ 0.1, 0.1, 0.1 ], "localize": false, "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "('%.12s' * #form_button_text)", "target_property_name": "#text" }
          ]
        }
      },
      {
        "desc": {
          "type": "label", "layer": 3, "size": [ 76, 8 ], "offset": [ 22, 13 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "font_scale_factor": 0.7, "color": [ 0.3, 0.3, 0.3 ], "localize": false, "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "(('%.32s' * #form_button_text) - ('%.12s' * #form_button_text))", "target_property_name": "#text" }
          ]
        }
      },
      { "bar_bg@cvo.bar_bg_image": {} },
      {
        "bar": {
          "type": "image", "layer": 3, "texture": "textures/ui/filled_progress_bar", "size": [ 76, 3 ], "offset": [ 22, 24 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "clip_direction": "left",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" },
            { "binding_type": "view", "source_property_name": "(1 - (((#form_button_text - ('%.32s' * #form_button_text)) - 0) / 100))", "target_property_name": "#clip_ratio" }
          ]
        }
      }
    ]
  },

  "face_view": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$bg_texture|default": "textures/ui/button_borderless_light",
    "controls": [
      { "bg@cvo.bg_image": {} },
      { "icon@cvo.icon_image": {} },
      {
        "name": {
          "type": "label", "layer": 3, "size": [ 76, 10 ], "offset": [ 22, 3 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "color": [ 0.1, 0.1, 0.1 ], "localize": false, "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" },
            { "binding_type": "view", "source_property_name": "('%.12s' * #form_button_text)", "target_property_name": "#text" }
          ]
        }
      },
      {
        "desc": {
          "type": "label", "layer": 3, "size": [ 76, 8 ], "offset": [ 22, 13 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "font_scale_factor": 0.7, "color": [ 0.3, 0.3, 0.3 ], "localize": false, "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" },
            { "binding_type": "view", "source_property_name": "(('%.32s' * #form_button_text) - ('%.12s' * #form_button_text))", "target_property_name": "#text" }
          ]
        }
      },
      { "bar_bg@cvo.bar_bg_image": {} },
      {
        "bar": {
          "type": "image", "layer": 3, "texture": "textures/ui/filled_progress_bar", "size": [ 76, 3 ], "offset": [ 22, 24 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "clip_direction": "left",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text" },
            { "binding_type": "view", "source_property_name": "(1 - (((#form_button_text - ('%.32s' * #form_button_text)) - 0) / 100))", "target_property_name": "#clip_ratio" }
          ]
        }
      }
    ]
  },

  "cell_always@common.button": {
    "size": [ 100, 30 ],
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons", "binding_condition": "always" } ],
    "controls": [
      { "default@cvo.face_always": {} },
      { "hover@cvo.face_always": { "$bg_texture": "textures/ui/button_borderless_lighthover" } },
      { "pressed@cvo.face_always": { "$bg_texture": "textures/ui/button_borderless_lightpressed" } }
    ]
  },

  "cell_view@common.button": {
    "size": [ 100, 30 ],
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons", "binding_condition": "always" } ],
    "controls": [
      { "default@cvo.face_view": {} },
      { "hover@cvo.face_view": { "$bg_texture": "textures/ui/button_borderless_lighthover" } },
      { "pressed@cvo.face_view": { "$bg_texture": "textures/ui/button_borderless_lightpressed" } }
    ]
  },

  "grid_always": {
    "type": "grid",
    "size": [ 200, "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "cvo.cell_always",
    "collection_name": "form_buttons",
    "bindings": [
      { "binding_name": "#form_button_length", "binding_name_override": "#maximum_grid_items", "binding_condition": "always" }
    ]
  },

  "grid_view": {
    "type": "grid",
    "size": [ 200, "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "cvo.cell_view",
    "collection_name": "form_buttons",
    "bindings": [
      { "binding_name": "#form_button_length", "binding_name_override": "#maximum_grid_items", "binding_condition": "always" }
    ]
  },

  "body_always": {
    "type": "panel",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [ { "grid@cvo.grid_always": {} } ]
  },

  "body_view": {
    "type": "panel",
    "size": [ "100% - 4px", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [ { "grid@cvo.grid_view": {} } ]
  },

  "scroll_always": {
    "type": "panel",
    "size": [ 216, "100% - 24px" ],
    "offset": [ 0, 18 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "cvo.body_always",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100% - 2px" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ]
        }
      }
    ]
  },

  "scroll_view": {
    "type": "panel",
    "size": [ 216, "100% - 24px" ],
    "offset": [ 0, 18 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": [ "100%", "100%" ],
          "$scrolling_content": "cvo.body_view",
          "$scroll_size": [ 5, "100% - 4px" ],
          "$scrolling_pane_size": [ "100% - 4px", "100% - 2px" ],
          "$scrolling_pane_offset": [ 2, 0 ],
          "$scroll_bar_right_padding_size": [ 0, 0 ]
        }
      }
    ]
  },

  "window_always": {
    "type": "image",
    "texture": "textures/ui/dialog_background_opaque",
    "size": [ 224, "85%" ],
    "layer": 60,
    "controls": [
      { "head": { "type": "label", "layer": 3, "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 6, 6 ], "text": "A: collection then view, always", "localize": false, "color": [ 0.25, 0.25, 0.25 ], "font_scale_factor": 0.8 } },
      { "close@common.close_button": {} },
      { "scroll@cvo.scroll_always": {} }
    ]
  },

  "window_view": {
    "type": "image",
    "texture": "textures/ui/dialog_background_opaque",
    "size": [ 224, "85%" ],
    "layer": 60,
    "controls": [
      { "head": { "type": "label", "layer": 3, "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 6, 6 ], "text": "V: collection then view, no always", "localize": false, "color": [ 0.25, 0.25, 0.25 ], "font_scale_factor": 0.8 } },
      { "close@common.close_button": {} },
      { "scroll@cvo.scroll_view": {} }
    ]
  },

  "screen_router": {
    "type": "collection_panel",
    "size": [ "100%", "100%" ],
    "factory": {
      "name": "cvo_screen",
      "control_ids": { "a": "@cvo.window_always", "v": "@cvo.window_view" }
    },
    "property_bag": { "#§b§wcv:A": [ "a" ], "#§b§wcv:V": [ "v" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.10s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  }
}
