{
  "namespace": "re6v",

  "lbl": {
    "type": "label",
    "size": [ 190, 10 ],
    "color": [ 1, 1, 0 ],
    "layer": 200,
    "shadow": true
  },

  "val": {
    "type": "label",
    "size": [ 60, 10 ],
    "color": [ 0.4, 1, 0.4 ],
    "layer": 200,
    "shadow": true
  },

  "valtrue": {
    "type": "label",
    "size": [ 60, 10 ],
    "color": [ 0.4, 1, 1 ],
    "layer": 200,
    "shadow": true,
    "text": "TRUE",
    "visible": "$row_value"
  },

  "valfalse": {
    "type": "label",
    "size": [ 60, 10 ],
    "color": [ 1, 0.4, 0.4 ],
    "layer": 200,
    "shadow": true,
    "text": "FALSE",
    "visible": "(not $row_value)"
  },

  "row": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 10 ],
    "controls": [
      { "n@re6v.lbl": { "text": "$row_name" } },
      { "v@re6v.val": { "text": "$row_value" } },
      { "t@re6v.valtrue": {} },
      { "f@re6v.valfalse": {} }
    ]
  },

  "pausepanel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 150, "100%c" ],
    "layer": 200,
    "$is_big_screen|default": "UNSET",
    "controls": [
      { "p1@re6v.row": { "$row_name": "big", "$row_value": "$is_big_screen" } }
    ]
  },

  "panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 4, 4 ],
    "size": [ 340, "100%c" ],
    "layer": 200,
    "$gamepad|default": "UNSET",
    "$game_pad|default": "UNSET",
    "$mouse|default": "UNSET",
    "$touch|default": "UNSET",
    "$desktop_screen|default": "UNSET",
    "$pocket_screen|default": "UNSET",
    "$is_big_screen|default": "UNSET",
    "$pre_release|default": "UNSET",
    "$is_publish|default": "UNSET",
    "$win10_edition|default": "UNSET",
    "$is_desktop|default": "UNSET",
    "$ms_platform|default": "UNSET",
    "$education_edition|default": "UNSET",
    "$build_platform_UWP|default": "UNSET",
    "$chat_text_color|default": "UNSET",
    "$re6_only|default": "UNSET",
    "controls": [
      { "r1@re6v.row": { "$row_name": "game_pad", "$row_value": "$game_pad" } },
      { "r2@re6v.row": { "$row_name": "mouse", "$row_value": "$mouse" } },
      { "r3@re6v.row": { "$row_name": "touch (pack: PACK_TOUCH)", "$row_value": "$touch" } },
      { "r4@re6v.row": { "$row_name": "desktop_screen (pack: PACK_DESK)", "$row_value": "$desktop_screen" } },
      { "r5@re6v.row": { "$row_name": "pocket_screen", "$row_value": "$pocket_screen" } },
      { "r6@re6v.row": { "$row_name": "is_big_screen", "$row_value": "$is_big_screen" } },
      { "r7@re6v.row": { "$row_name": "gamepad", "$row_value": "$gamepad" } },
      { "r8@re6v.row": { "$row_name": "pre_release (pack: PACK_PRE)", "$row_value": "$pre_release" } },
      { "r9@re6v.row": { "$row_name": "is_publish (pack: PACK_PUB)", "$row_value": "$is_publish" } },
      { "r10@re6v.row": { "$row_name": "win10_edition", "$row_value": "$win10_edition" } },
      { "r11@re6v.row": { "$row_name": "is_desktop", "$row_value": "$is_desktop" } },
      { "r12@re6v.row": { "$row_name": "ms_platform", "$row_value": "$ms_platform" } },
      { "r13@re6v.row": { "$row_name": "education_edition", "$row_value": "$education_edition" } },
      { "r14@re6v.row": { "$row_name": "build_platform_UWP", "$row_value": "$build_platform_UWP" } },
      { "r15@re6v.row": { "$row_name": "chat_text_color", "$row_value": "$chat_text_color" } },
      { "r16@re6v.row": { "$row_name": "re6_only (pack: PACK_ONLY)", "$row_value": "$re6_only" } }
    ]
  }
}
