{
  "namespace": "re9",

  "tl": {
    "type": "label",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "layer": 60,
    "color": [1, 1, 1],
    "shadow": false
  },

  "ex_f@re9.tl": {
    "text": "F",
    "offset": [100, 0],
    "size": [10, 9],
    "color": [1, 0.3, 0.3],
    "property_bag": { "#probe": false },
    "bindings": [
      { "binding_name": "$b", "binding_name_override": "#probe", "binding_type": "global" },
      { "binding_type": "view", "source_property_name": "#probe", "target_property_name": "#visible" }
    ]
  },
  "ex_t@re9.tl": {
    "text": "T",
    "offset": [112, 0],
    "size": [10, 9],
    "color": [0.3, 1, 0.3],
    "property_bag": { "#probe": true },
    "bindings": [
      { "binding_name": "$b", "binding_name_override": "#probe", "binding_type": "global" },
      { "binding_type": "view", "source_property_name": "#probe", "target_property_name": "#visible" }
    ]
  },
  "ex_v@re9.tl": {
    "text": "#text",
    "offset": [124, 0],
    "size": [80, 9],
    "color": [0.6, 0.8, 1],
    "property_bag": { "#probe": "M" },
    "bindings": [
      { "binding_name": "$b", "binding_name_override": "#probe", "binding_type": "global" },
      { "binding_type": "view", "source_property_name": "('V' + #probe)", "target_property_name": "#text" }
    ]
  },
  "ex_row": {
    "type": "panel",
    "size": [210, 9],
    "controls": [
      { "n@re9.tl": { "text": "$b", "size": [98, 9] } },
      { "f@re9.ex_f": {} },
      { "t@re9.ex_t": {} },
      { "v@re9.ex_v": {} }
    ]
  },

  "clip_bg": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [0.3, 0.3, 0.3],
    "size": [80, 5],
    "layer": 61,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [60, 1]
  },
  "clip_fg@re9.clip_bg": {
    "texture": "textures/blocks/emerald_block",
    "color": [1, 1, 1],
    "layer": 62,
    "clip_direction": "left",
    "clip_ratio": 0.0,
    "bindings": [
      { "binding_type": "view", "source_property_name": "$cexpr", "target_property_name": "#clip_ratio" }
    ]
  },
  "clip_row": {
    "type": "panel",
    "size": [210, 7],
    "$cpb_v|default": 0,
    "controls": [
      { "n@re9.tl": { "text": "$cname", "size": [58, 7], "font_scale_factor": 0.7 } },
      { "fg@re9.clip_fg": { "property_bag": { "#v": "$cpb_v" } } }
    ]
  },

  "a_sq": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [1, 1, 1],
    "size": [20, 20],
    "layer": 62,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  "alpha_row": {
    "type": "panel",
    "size": [210, 22],
    "controls": [
      { "bg@re9.a_sq": { "color": [0, 0, 0], "size": [130, 22], "layer": 61 } },
      { "a_pb@re9.a_sq": { "offset": [1, 1], "alpha": "#alpha", "property_bag": { "#a": 0.5 }, "bindings": [ { "binding_type": "view", "source_property_name": "#a", "target_property_name": "#alpha" } ] } },
      { "a_lit@re9.a_sq": { "offset": [27, 1], "alpha": "#alpha", "bindings": [ { "binding_type": "view", "source_property_name": "(1 * .5)", "target_property_name": "#alpha" } ] } },
      { "a_static@re9.a_sq": { "offset": [53, 1], "alpha": 0.5 } },
      { "a_one@re9.a_sq": { "offset": [79, 1], "alpha": 1.0 } },
      { "a_zero@re9.a_sq": { "offset": [105, 1], "alpha": 0.0 } }
    ]
  },

  "sz_box": {
    "type": "image",
    "texture": "textures/ui/White",
    "layer": 62,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  "size_row": {
    "type": "panel",
    "size": [210, 24],
    "controls": [
      { "re9_s_100cpct": { "type": "panel", "size": ["100c%", 10], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [0, 0],
          "controls": [ { "k@re9.sz_box": { "size": [30, 10], "color": [1, 0, 0] } } ] } },
      { "re9_s_50pcm": { "type": "panel", "size": ["50%cm", 10], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [40, 0],
          "controls": [ { "k1@re9.sz_box": { "size": [30, 10], "color": [0, 1, 0] } }, { "k2@re9.sz_box": { "size": [90, 4], "color": [0, 0, 1] } } ] } },
      { "re9_s_50cpct": { "type": "panel", "size": ["50c%", 4], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [0, 12],
          "controls": [ { "k@re9.sz_box": { "size": [30, 4], "color": [1, 0.5, 0] } } ] } },
      { "re9_s_50pcm_h": { "type": "panel", "size": [10, "50%cm"], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [0, 18],
          "controls": [ { "k1@re9.sz_box": { "size": [4, 10], "color": [0.5, 1, 0.5] } }, { "k2@re9.sz_box": { "size": [4, 30], "color": [0.5, 0.5, 0.5] } } ] } },
      { "re9_s_pc": { "type": "panel", "size": ["100%c", "100%c"], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [100, 0],
          "controls": [ { "k1@re9.sz_box": { "size": [30, 10], "color": [1, 1, 0] } }, { "k2@re9.sz_box": { "size": [50, 20], "color": [0, 1, 1], "layer": 61 } } ] } },
      { "re9_s_pcm": { "type": "panel", "size": ["100%cm", "100%cm"], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [160, 0],
          "controls": [ { "k1@re9.sz_box": { "size": [30, 10], "color": [1, 0, 1] } }, { "k2@re9.sz_box": { "size": [40, 20], "color": [0.5, 0.5, 1], "layer": 61 } } ] } }
    ]
  },

  "x_row@re9.tl": {
    "text": "#text",
    "size": [210, 9],
    "color": [1, 1, 0.5],
    "bindings": [
      { "binding_type": "view", "source_property_name": "$xexpr", "target_property_name": "#text" }
    ]
  },

  "vr_label@re9.tl": {
    "size": [210, 9],
    "color": [1, 0.7, 1]
  },

  "col_a": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 4],
    "size": [210, "100%c"],
    "controls": [
      { "ex_gp@re9.ex_row": { "$b": "#is_using_gamepad" } },
      { "ex_ride@re9.ex_row": { "$b": "#is_riding" } },
      { "ex_none@re9.ex_row": { "$b": "#re9_nonexistent_binding" } },
      { "ex_vr@re9.ex_row": { "$b": "#vr" } },
      { "ex_cur@re9.ex_row": { "$b": "#show_cursor" } },
      { "ex_inv@re9.ex_row": { "$b": "#inventory_button_enabled" } },
      { "ex_fw@re9.ex_row": { "$b": "#focus_wrap_enabled" } },
      { "ex_tts@re9.ex_row": { "$b": "#tts_enabled" } },
      { "ex_saf@re9.ex_row": { "$b": "#safezone_inner_top" } },
      { "ex_hide@re9.ex_row": { "$b": "#hud_visible_centered" } },
      { "c_pb50@re9.clip_row": { "$cname": "v50*.01", "$cexpr": "(#v * .01)", "$cpb_v": 50 } },
      { "c_pb50s@re9.clip_row": { "$cname": "(v-0)*.01", "$cexpr": "((#v - 0) * .01)", "$cpb_v": 50 } },
      { "c_max@re9.clip_row": { "$cname": "(20.0-15)/max", "$cexpr": "((20.0 - 15) / $max)", "$max": 20.0 } },
      { "c_max_direct": { "type": "panel", "size": [210, 7],
          "controls": [
            { "n@re9.tl": { "text": "direct max", "size": [58, 7], "font_scale_factor": 0.7 } },
            { "fg@re9.clip_bg": { "texture": "textures/blocks/emerald_block", "color": [1, 1, 1], "layer": 62, "clip_direction": "left", "clip_ratio": 0.0, "$max": 20.0,
                "property_bag": { "#z": 0 },
                "bindings": [ { "binding_type": "view", "source_property_name": "(((20.0 - 15) / $max) + #z)", "target_property_name": "#clip_ratio" } ] } }
          ] } },
      { "c_static25": { "type": "panel", "size": [210, 7],
          "controls": [
            { "n@re9.tl": { "text": "static .25", "size": [58, 7], "font_scale_factor": 0.7 } },
            { "fg@re9.clip_bg": { "texture": "textures/blocks/emerald_block", "color": [1, 1, 1], "layer": 62, "clip_direction": "left", "clip_ratio": 0.25 } }
          ] } },
      { "c_static0": { "type": "panel", "size": [210, 7],
          "controls": [
            { "n@re9.tl": { "text": "static 0", "size": [58, 7], "font_scale_factor": 0.7 } },
            { "fg@re9.clip_bg": { "texture": "textures/blocks/emerald_block", "color": [1, 1, 1], "layer": 62, "clip_direction": "left", "clip_ratio": 0.0 } }
          ] } },
      { "c_pbf@re9.clip_row": { "$cname": "pb 0.25", "$cexpr": "#v", "$cpb_v": 0.25 } },
      { "c_lit@re9.clip_row": { "$cname": "(.25)", "$cexpr": "(.25)" } },
      { "c_zero@re9.clip_row": { "$cname": "zero", "$cexpr": "(#v * 0)", "$cpb_v": 1 } },
      { "alpha@re9.alpha_row": {} },
      { "sizes@re9.size_row": {} }
    ]
  },

  "col_b": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [230, 4],
    "size": [210, "100%c"],
    "controls": [
      { "e_cut_text@re9.vr_label": { "$cut": "('%.3s' * 'abcdef')", "text": "$cut" } },
      { "e_cut_r@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$cut": "('%.3s' * 'abcdef')", "text": "#text",
          "bindings": [ { "binding_type": "view", "source_property_name": "('R' + $cut)", "target_property_name": "#text" } ] } },
      { "e_s3@re9.x_row": { "property_bag": { "#s": "abcdef" }, "$xexpr": "('A' + ('%.3s' * #s))" } },
      { "e_s3m@re9.x_row": { "property_bag": { "#s": "abcdef" }, "$xexpr": "(('%.3s' * #s) * 1)" } },
      { "e_s3mr@re9.x_row": { "property_bag": { "#s": "abcdef" }, "$xexpr": "('B' + (('%.3s' * #s) * 1))" } },
      { "e_max_gt@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "#text",
          "bindings": [ { "binding_type": "view", "source_property_name": "('C' + (((20.0 - 15) / $max) > .2))", "target_property_name": "#text" } ] } },
      { "e_max_lt@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "#text",
          "bindings": [ { "binding_type": "view", "source_property_name": "('D' + (((20.0 - 15) / $max) < .3))", "target_property_name": "#text" } ] } },
      { "e_max_vis_gt@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "VIS_GT_.2", "visible": "(((20.0 - 15) / $max) > .2)" } },
      { "e_max_vis_lt@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "VIS_LT_.3", "visible": "(((20.0 - 15) / $max) < .3)" } },
      { "e_max_vis_z@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "VIS_GT_0", "visible": "(((20.0 - 15) / $max) > 0)" } },
      { "e_max_pb@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "#text", "property_bag": { "#z": 0 },
          "bindings": [ { "binding_type": "view", "source_property_name": "('G' + ((((20.0 - 15) / $max) + #z) > .2) + (((((20.0 - 15) / $max) + #z) < .3)))", "target_property_name": "#text" } ] } },
      { "e_cut_r2@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$cut": "('%.3s' * 'abcdef')", "text": "#text", "property_bag": { "#z": "R" },
          "bindings": [ { "binding_type": "view", "source_property_name": "(#z + $cut)", "target_property_name": "#text" } ] } },
      { "e_max_x100@re9.tl": { "size": [210, 9], "color": [1, 1, 0.5], "$max": 20.0, "text": "#text",
          "bindings": [ { "binding_type": "view", "source_property_name": "('E' + ((20.0 - 15) * 100 / $max))", "target_property_name": "#text" } ] } },
      { "m_13@re9.x_row": { "property_bag": { "#v": 13 }, "$xexpr": "('M' + (#v - ((#v / 5) * 5)))" } },
      { "m_13div@re9.x_row": { "property_bag": { "#v": 13 }, "$xexpr": "('N' + (#v / 5))" } },
      { "m_neg7@re9.x_row": { "property_bag": { "#v": -7 }, "$xexpr": "('O' + (#v - ((#v / 5) * 5)))" } },
      { "m_str13@re9.x_row": { "property_bag": { "#v": "13" }, "$xexpr": "('P' + ((#v - 0) - (((#v - 0) / 5) * 5)))" } },
      { "m_20@re9.x_row": { "property_bag": { "#v": 20 }, "$xexpr": "('Q' + (#v - ((#v / 5) * 5)))" } },
      { "dup_row": { "type": "panel", "size": [210, 9],
          "controls": [
            { "re9dup@re9.tl": { "text": "DUP_A", "size": [40, 9] } },
            { "re9dup@re9.tl": { "text": "DUP_B", "size": [40, 9], "offset": [50, 0] } }
          ] } },
      { "v_noreq_def@re9.vr_label": { "$vt|default": "DEF", "variables": [ { "$vt": "NOREQ" } ], "text": "$vt" } },
      { "v_noreq_only@re9.vr_label": { "variables": [ { "$vo": "ONLY" } ], "text": "$vo" } },
      { "v_req_true@re9.vr_label": { "$vt|default": "DEF2", "$re9_true": true, "variables": [ { "requires": "$re9_true", "$vt": "REQ" } ], "text": "$vt" } },
      { "v_req_false@re9.vr_label": { "$vt|default": "DEF3", "$re9_false": false, "variables": [ { "requires": "$re9_false", "$vt": "REQF" } ], "text": "$vt" } },
      { "fonts": { "type": "stack_panel", "orientation": "horizontal", "size": [210, 40],
          "controls": [
            { "f_small@re9.tl": { "text": "Hg", "font_size": "small", "size": ["default", "default"] } },
            { "f_normal@re9.tl": { "text": "Hg", "font_size": "normal", "size": ["default", "default"] } },
            { "f_large@re9.tl": { "text": "Hg", "font_size": "large", "size": ["default", "default"] } },
            { "f_xl@re9.tl": { "text": "Hg", "font_size": "extra_large", "size": ["default", "default"] } }
          ] } }
    ]
  },

  "hud_probe": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "re9_col_a@re9.col_a": {} },
      { "re9_col_b@re9.col_b": {} }
    ]
  },

  "cmp_label@re9.tl": {
    "size": [180, 9],
    "color": [0, 1, 0]
  },

  "ab_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [180, "100%c"],
    "offset": [0, -60],
    "controls": [
      { "ab_text@re9.cmp_label": { "text": "$actionbar_text", "localize": false } },
      { "ab_eq@re9.cmp_label": { "text": "AB_EQ", "visible": "($actionbar_text = 'xyz')" } },
      { "ab_ne@re9.cmp_label": { "text": "AB_NE", "visible": "(not ($actionbar_text = 'xyz'))" } },
      { "ab_copy@re9.cmp_label": { "text": "AB_COPY_EQ", "$copy": "$actionbar_text", "visible": "($copy = 'xyz')" } },
      { "ab_copy_ne@re9.cmp_label": { "text": "AB_COPY_NE", "$copy": "$actionbar_text", "visible": "(not ($copy = 'xyz'))" } },
      { "abq45@re9.cmp_label": { "text": "ABA>.45", "visible": "($actionbar_text_background_alpha > .45)" } },
      { "abq55@re9.cmp_label": { "text": "ABA>.55", "visible": "($actionbar_text_background_alpha > .55)" } },
      { "abq70@re9.cmp_label": { "text": "ABA>.7", "visible": "($actionbar_text_background_alpha > .7)" } }
    ]
  },

  "thr_row": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [200, 9],
    "controls": [
      { "tq10@re9.tl": { "text": ">.1 ", "size": [20, 9], "visible": "($a > .1)" } },
      { "tq30@re9.tl": { "text": ">.3 ", "size": [20, 9], "visible": "($a > .3)" } },
      { "tq45@re9.tl": { "text": ">.45 ", "size": [25, 9], "visible": "($a > .45)" } },
      { "tq55@re9.tl": { "text": ">.55 ", "size": [25, 9], "visible": "($a > .55)" } },
      { "tq70@re9.tl": { "text": ">.7 ", "size": [20, 9], "visible": "($a > .7)" } },
      { "tq90@re9.tl": { "text": ">.9 ", "size": [20, 9], "visible": "($a > .9)" } }
    ]
  },

  "title_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [200, "100%c"],
    "controls": [
      { "ta@re9.thr_row": { "$a": "$title_alpha" } },
      { "ts_on@re9.cmp_label": { "text": "TSHADOW_T", "visible": "$title_shadow" } },
      { "ts_off@re9.cmp_label": { "text": "TSHADOW_F", "visible": "(not $title_shadow)" } }
    ]
  },

  "item_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [200, "100%c"],
    "controls": [
      { "ia": { "type": "stack_panel", "orientation": "horizontal", "size": [200, 9], "$a": "$item_text_background_alpha",
          "controls": [
            { "iq10@re9.tl": { "text": "i>.1 ", "size": [25, 9], "visible": "($a > .1)" } },
            { "iq30@re9.tl": { "text": "i>.3 ", "size": [25, 9], "visible": "($a > .3)" } },
            { "iq45@re9.tl": { "text": "i>.45 ", "size": [30, 9], "visible": "($a > .45)" } },
            { "iq55@re9.tl": { "text": "i>.55 ", "size": [30, 9], "visible": "($a > .55)" } },
            { "iq70@re9.tl": { "text": "i>.7 ", "size": [25, 9], "visible": "($a > .7)" } },
            { "iq90@re9.tl": { "text": "i>.9 ", "size": [25, 9], "visible": "($a > .9)" } }
          ] } }
    ]
  },

  "c_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [-190, 0],
    "size": [180, "100%c"],
    "controls": [
      { "c_text@re9.cmp_label": { "text": "$container_title", "localize": false } },
      { "c_eq_box@re9.cmp_label": { "text": "EQ_BOX", "visible": "($container_title = 'RE9Box')" } },
      { "c_ne_box@re9.cmp_label": { "text": "NE_BOX", "visible": "(not ($container_title = 'RE9Box'))" } },
      { "c_copy_box@re9.cmp_label": { "text": "COPY_EQ_BOX", "$copy": "$container_title", "visible": "($copy = 'RE9Box')" } },
      { "c_eq_boat@re9.cmp_label": { "text": "EQ_BOAT", "visible": "($container_title = 'RE9Boat')" } },
      { "c_copy_boat@re9.cmp_label": { "text": "COPY_EQ_BOAT", "$copy": "$container_title", "visible": "($copy = 'RE9Boat')" } },
      { "c_eq_donkey@re9.cmp_label": { "text": "EQ_DONKEY", "visible": "($container_title = 'RE9Donkey')" } },
      { "c_copy_donkey@re9.cmp_label": { "text": "COPY_EQ_DONKEY", "$copy": "$container_title", "visible": "($copy = 'RE9Donkey')" } },
      { "c_copy_chest@re9.cmp_label": { "text": "COPY_EQ_CHEST", "$copy": "$container_title", "visible": "($copy = 'container.chest')" } },
      { "c_copy_large@re9.cmp_label": { "text": "COPY_EQ_LARGE", "$copy": "$container_title", "visible": "($copy = 'container.chestDouble')" } },
      { "c_loc@re9.cmp_label": { "text": "LOCALIZE_T", "visible": "$localize_title" } },
      { "c_r1@re9.cmp_label": { "text": "ROWS1", "visible": "$container_rows_1" } },
      { "c_r2@re9.cmp_label": { "text": "ROWS2", "visible": "$container_rows_2" } },
      { "c_r3@re9.cmp_label": { "text": "ROWS3", "visible": "$container_rows_3" } },
      { "c_r4@re9.cmp_label": { "text": "ROWS4", "visible": "$container_rows_4" } },
      { "c_r5@re9.cmp_label": { "text": "ROWS5", "visible": "$container_rows_5" } },
      { "c_r6@re9.cmp_label": { "text": "ROWS6", "visible": "$container_rows_6" } },
      { "c_size@re9.cmp_label": { "text": "#text", "bindings": [ { "binding_type": "view", "source_property_name": "('CS' + $container_size)", "target_property_name": "#text" } ] } },
      { "c_chest@re9.cmp_label": { "text": "#text", "bindings": [ { "binding_type": "view", "source_property_name": "('CH' + $chest_size)", "target_property_name": "#text" } ] } },
      { "c_size_gt@re9.cmp_label": { "text": "SIZE_GT26", "visible": "($container_size > 26)" } },
      { "c_size_gt53@re9.cmp_label": { "text": "SIZE_GT53", "visible": "($container_size > 53)" } },
      { "c_chest_gt@re9.cmp_label": { "text": "CHEST_GT26", "visible": "($chest_size > 26)" } },
      { "c_chest_gt0@re9.cmp_label": { "text": "CHEST_GT0", "visible": "($chest_size > 0)" } }
    ]
  },

  "chat_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [-4, 40],
    "size": [180, "100%c"],
    "layer": 50,
    "controls": [
      { "mm_text@re9.cmp_label": { "text": "$max_messages" } },
      { "mm_r@re9.cmp_label": { "text": "#text", "bindings": [ { "binding_type": "view", "source_property_name": "('MM' + $max_messages)", "target_property_name": "#text" } ] } },
      { "ml_text@re9.cmp_label": { "text": "$max_text_edit_length" } },
      { "ml_r@re9.cmp_label": { "text": "#text", "bindings": [ { "binding_type": "view", "source_property_name": "('ML' + $max_text_edit_length)", "target_property_name": "#text" } ] } }
    ]
  },

  "book_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 4],
    "size": [180, "100%c"],
    "layer": 50,
    "controls": [
      { "bp_r@re9.cmp_label": { "text": "#text", "bindings": [ { "binding_type": "view", "source_property_name": "('PL' + $max_page_length)", "target_property_name": "#text" } ] } },
      { "bt_r@re9.cmp_label": { "text": "#text", "bindings": [ { "binding_type": "view", "source_property_name": "('TL' + $max_title_length)", "target_property_name": "#text" } ] } }
    ]
  },

  "sign_probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 4],
    "size": [300, "100%c"],
    "layer": 50,
    "controls": [
      { "st@re9.cmp_label": { "text": "$sign_texture", "localize": false, "size": [300, 9] } },
      { "sm@re9.cmp_label": { "text": "$sign_text_multiline", "localize": false, "size": [300, 9] } }
    ]
  },

  "form_probe": {
    "type": "panel",
    "size": ["100%", "100%c"],
    "controls": [
      { "fp@re9.col_form": {} }
    ]
  },

  "col_form": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [210, "100%c"],
    "controls": [
      { "fx_gp@re9.ex_row": { "$b": "#is_using_gamepad" } },
      { "fx_none@re9.ex_row": { "$b": "#re9_nonexistent_binding" } },
      { "fx_saf@re9.ex_row": { "$b": "#safezone_inner_top" } },
      { "fx_tts@re9.ex_row": { "$b": "#tts_enabled" } },
      { "fx_ghv@re9.ex_row": { "$b": "#gamepad_helper_visible" } }
    ]
  }
}
