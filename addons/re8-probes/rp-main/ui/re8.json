{
  "namespace": "re8",
  "probe_label": {
    "type": "label",
    "text": "$b",
    "size": [150, 9],
    "layer": 60,
    "color": [1, 1, 0],
    "bindings": [
      {
        "binding_name": "$b",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ]
  },
  "always_label": {
    "type": "label",
    "text": "always",
    "size": [150, 9],
    "layer": 60,
    "color": [0, 1, 0]
  },
  "hb_cell_shield": {
    "type": "label",
    "text": "S",
    "size": [10, 9],
    "layer": 60,
    "color": [1, 0, 0],
    "bindings": [
      {
        "binding_name": "#shield_is_active",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      }
    ]
  },
  "hb_cell_pickup": {
    "type": "label",
    "text": "P",
    "size": [10, 9],
    "layer": 60,
    "color": [0, 0.6, 1],
    "bindings": [
      {
        "binding_name": "#show_item_pickup",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      }
    ]
  },
  "hb_grid_shield": {
    "type": "grid",
    "size": [90, 9],
    "grid_dimensions": [9, 1],
    "maximum_grid_items": 9,
    "collection_name": "hotbar_items",
    "grid_item_template": "re8.hb_cell_shield"
  },
  "hb_grid_pickup": {
    "type": "grid",
    "size": [90, 9],
    "grid_dimensions": [9, 1],
    "maximum_grid_items": 9,
    "collection_name": "hotbar_items",
    "grid_item_template": "re8.hb_cell_pickup"
  },
  "c_text": {
    "type": "label",
    "text": "$container_title",
    "size": [150, 9],
    "layer": 60,
    "color": [1, 1, 0]
  },
  "c_vis": {
    "type": "label",
    "text": "VIS_EQ",
    "size": [150, 9],
    "layer": 60,
    "color": [0, 1, 0],
    "visible": "($container_title = 'container.chest')"
  },
  "c_vis_ne": {
    "type": "label",
    "text": "VIS_NE",
    "size": [150, 9],
    "layer": 60,
    "color": [1, 0.5, 0],
    "visible": "(not ($container_title = 'container.chest'))"
  },
  "c_copy": {
    "type": "label",
    "text": "COPY_EQ",
    "size": [150, 9],
    "layer": 60,
    "color": [0, 1, 1],
    "$copy": "$container_title",
    "visible": "($copy = 'container.chest')"
  },
  "c_rows": {
    "type": "label",
    "text": "ROWS3",
    "size": [150, 9],
    "layer": 60,
    "color": [1, 0, 1],
    "visible": "$container_rows_3"
  },
  "c_size": {
    "type": "label",
    "text": "SIZE_GT26",
    "size": [150, 9],
    "layer": 60,
    "color": [1, 1, 1],
    "visible": "($container_size > 26)"
  },
  "cprobe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [10, 30],
    "size": [160, 80],
    "controls": [
      { "c_text@re8.c_text": {} },
      { "c_vis@re8.c_vis": {} },
      { "c_vis_ne@re8.c_vis_ne": {} },
      { "c_copy@re8.c_copy": {} },
      { "c_rows@re8.c_rows": {} },
      { "c_size@re8.c_size": {} }
    ]
  },
  "probe": {
    "type": "stack_panel",
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 40],
    "size": [160, 120],
    "controls": [
      { "lbl_always@re8.always_label": {} },
      { "lbl_vr@re8.probe_label": { "$b": "#vr" } },
      { "lbl_is_riding@re8.probe_label": { "$b": "#is_riding" } },
      { "lbl_show_cursor@re8.probe_label": { "$b": "#show_cursor" } },
      { "lbl_inventory_button_enabled@re8.probe_label": { "$b": "#inventory_button_enabled" } },
      { "lbl_shield_is_active@re8.probe_label": { "$b": "#shield_is_active" } },
      { "lbl_show_item_pickup@re8.probe_label": { "$b": "#show_item_pickup" } },
      { "lbl_focus_wrap_enabled@re8.probe_label": { "$b": "#focus_wrap_enabled" } },
      { "lbl_is_using_gamepad@re8.probe_label": { "$b": "#is_using_gamepad" } },
      { "lbl_nonexistent@re8.probe_label": { "$b": "#re8_nonexistent_binding" } },
      { "hb_grid_shield@re8.hb_grid_shield": {} },
      { "hb_grid_pickup@re8.hb_grid_pickup": {} }
    ]
  }
}
