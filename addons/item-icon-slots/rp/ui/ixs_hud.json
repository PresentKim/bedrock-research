{
  "namespace": "ixs_hud",

  "frame": {
    "type": "image", "texture": "textures/ui/hud_tip_text_background", "alpha": 0.7, "size": [ "100%c + 8px", "100%c + 8px" ],
    "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 40 ],
    "bindings": [
      { "binding_type": "global", "binding_name": "#hud_title_text_string" },
      { "binding_type": "view", "source_property_name": "$box_rule", "target_property_name": "#visible" }
    ]
  },

  "caption": {
    "type": "label", "localize": false, "size": [ "default", 10 ], "color": [ 1, 1, 1 ], "font_scale_factor": 0.7, "text": "$caption"
  },

  "cell_bg": { "type": "image", "texture": "textures/ui/cell_image", "size": [ 18, 18 ], "layer": 1 },

  "live": {
    "type": "panel", "size": [ 18, 18 ], "collection_index": "$slot",
    "controls": [
      { "bg@ixs_hud.cell_bg": {} },
      {
        "icon": {
          "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "layer": 2,
          "property_bag": { "#item_id_aux": 0 },
          "bindings": [ { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#item_id_aux", "binding_condition": "always" } ]
        }
      }
    ]
  },

  "locked": {
    "type": "panel", "size": [ 18, 18 ], "collection_index": "$slot",
    "controls": [
      { "bg@ixs_hud.cell_bg": {} },
      {
        "data": {
          "type": "panel", "size": [ 0, 0 ],
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#item_id_aux", "binding_condition": "visibility_changed" },
            { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#item_lock_in_slot", "binding_condition": "visibility_changed" }
          ]
        }
      },
      {
        "icon": {
          "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "layer": 2,
          "property_bag": { "#item_id_aux": 0 },
          "bindings": [
            { "binding_type": "view", "source_control_name": "data", "resolve_sibling_scope": true, "source_property_name": "#item_id_aux", "target_property_name": "#item_id_aux" },
            { "binding_type": "view", "source_control_name": "data", "resolve_sibling_scope": true, "source_property_name": "#item_lock_in_slot", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  "counted": {
    "type": "panel", "size": [ 18, 18 ], "collection_index": 17,
    "bindings": [
      { "binding_type": "global", "binding_name": "#hud_title_text_string" },
      { "binding_type": "view", "source_property_name": "$show", "target_property_name": "#visible" }
    ],
    "controls": [
      { "bg@ixs_hud.cell_bg": {} },
      {
        "data": {
          "type": "panel", "size": [ 0, 0 ],
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#item_id_aux", "binding_condition": "visibility_changed" },
            { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#inventory_stack_count", "binding_condition": "visibility_changed" }
          ]
        }
      },
      {
        "icon": {
          "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "layer": 2,
          "property_bag": { "#item_id_aux": 0 },
          "bindings": [
            { "binding_type": "view", "source_control_name": "data", "resolve_sibling_scope": true, "source_property_name": "#item_id_aux", "target_property_name": "#item_id_aux" },
            { "binding_type": "view", "source_control_name": "data", "resolve_sibling_scope": true, "source_property_name": "$count_ok", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  "unchecked": {
    "type": "panel", "size": [ 18, 18 ], "collection_index": 17,
    "bindings": [
      { "binding_type": "global", "binding_name": "#hud_title_text_string" },
      { "binding_type": "view", "source_property_name": "$show", "target_property_name": "#visible" }
    ],
    "controls": [
      { "bg@ixs_hud.cell_bg": {} },
      {
        "icon": {
          "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "layer": 2,
          "property_bag": { "#item_id_aux": 0 },
          "bindings": [ { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#item_id_aux", "binding_condition": "visibility_changed" } ]
        }
      }
    ]
  },

  "six_row": {
    "type": "stack_panel", "orientation": "horizontal", "size": [ "100%c", 18 ], "collection_name": "hotbar_items",
    "controls": [
      { "s9@$cell": { "$slot": 9 } },
      { "s10@$cell": { "$slot": 10 } },
      { "s11@$cell": { "$slot": 11 } },
      { "s12@$cell": { "$slot": 12 } },
      { "s13@$cell": { "$slot": 13 } },
      { "s14@$cell": { "$slot": 14 } }
    ]
  },

  "backup_box@ixs_hud.frame": {
    "$box_rule": "(('%.4s' * #hud_title_text_string) = 'ixb:')",
    "controls": [
      {
        "column": {
          "type": "stack_panel", "orientation": "vertical", "size": [ "100%c", "100%c" ],
          "controls": [
            { "caption@ixs_hud.caption": { "$caption": "Slots 9-14, live (restored after 5 s)" } },
            { "row@ixs_hud.six_row": { "$cell": "ixs_hud.live" } }
          ]
        }
      }
    ]
  },

  "lock_box@ixs_hud.frame": {
    "$box_rule": "(('%.4s' * #hud_title_text_string) = 'ixl:')",
    "controls": [
      {
        "column": {
          "type": "stack_panel", "orientation": "vertical", "size": [ "100%c", "100%c" ],
          "controls": [
            { "caption1@ixs_hud.caption": { "$caption": "Frozen" } },
            { "frozen@ixs_hud.six_row": { "$cell": "ixs_hud.locked" } },
            { "caption2@ixs_hud.caption": { "$caption": "Live" } },
            { "live@ixs_hud.six_row": { "$cell": "ixs_hud.live" } }
          ]
        }
      }
    ]
  },

  "counted_box@ixs_hud.frame": {
    "$box_rule": "(('%.4s' * #hud_title_text_string) = 'ixc:')",
    "controls": [
      {
        "column": {
          "type": "stack_panel", "orientation": "vertical", "size": [ "100%c", "100%c" ],
          "controls": [
            { "caption@ixs_hud.caption": { "$caption": "Slot 17, frozen when the count matches" } },
            {
              "row": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ "100%c", 18 ], "collection_name": "hotbar_items",
                "controls": [
                  { "c0@ixs_hud.counted": { "$show": "(('%.5s' * #hud_title_text_string) = 'ixc:a')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 2)" } },
                  { "c1@ixs_hud.counted": { "$show": "(('%.6s' * #hud_title_text_string) = 'ixc:aa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 3)" } },
                  { "c2@ixs_hud.counted": { "$show": "(('%.7s' * #hud_title_text_string) = 'ixc:aaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 4)" } },
                  { "c3@ixs_hud.counted": { "$show": "(('%.8s' * #hud_title_text_string) = 'ixc:aaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 5)" } },
                  { "c4@ixs_hud.counted": { "$show": "(('%.9s' * #hud_title_text_string) = 'ixc:aaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 6)" } },
                  { "c5@ixs_hud.counted": { "$show": "(('%.10s' * #hud_title_text_string) = 'ixc:aaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 7)" } },
                  { "c6@ixs_hud.counted": { "$show": "(('%.11s' * #hud_title_text_string) = 'ixc:aaaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 8)" } },
                  { "c7@ixs_hud.counted": { "$show": "(('%.12s' * #hud_title_text_string) = 'ixc:aaaaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 9)" } },
                  { "c8@ixs_hud.counted": { "$show": "(('%.13s' * #hud_title_text_string) = 'ixc:aaaaaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 10)" } },
                  { "c9@ixs_hud.counted": { "$show": "(('%.14s' * #hud_title_text_string) = 'ixc:aaaaaaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 11)" } },
                  { "c10@ixs_hud.counted": { "$show": "(('%.15s' * #hud_title_text_string) = 'ixc:aaaaaaaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 12)" } },
                  { "c11@ixs_hud.counted": { "$show": "(('%.16s' * #hud_title_text_string) = 'ixc:aaaaaaaaaaaa')", "$count_ok": "(((#inventory_stack_count - '§r') - '§f') = 13)" } }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "unchecked_box@ixs_hud.frame": {
    "$box_rule": "(('%.4s' * #hud_title_text_string) = 'ixn:')",
    "controls": [
      {
        "column": {
          "type": "stack_panel", "orientation": "vertical", "size": [ "100%c", "100%c" ],
          "controls": [
            { "caption@ixs_hud.caption": { "$caption": "Slot 17, frozen without a check" } },
            {
              "row": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ "100%c", 18 ], "collection_name": "hotbar_items",
                "controls": [
                  { "c0@ixs_hud.unchecked": { "$show": "(('%.5s' * #hud_title_text_string) = 'ixn:a')" } },
                  { "c1@ixs_hud.unchecked": { "$show": "(('%.6s' * #hud_title_text_string) = 'ixn:aa')" } },
                  { "c2@ixs_hud.unchecked": { "$show": "(('%.7s' * #hud_title_text_string) = 'ixn:aaa')" } },
                  { "c3@ixs_hud.unchecked": { "$show": "(('%.8s' * #hud_title_text_string) = 'ixn:aaaa')" } },
                  { "c4@ixs_hud.unchecked": { "$show": "(('%.9s' * #hud_title_text_string) = 'ixn:aaaaa')" } },
                  { "c5@ixs_hud.unchecked": { "$show": "(('%.10s' * #hud_title_text_string) = 'ixn:aaaaaa')" } },
                  { "c6@ixs_hud.unchecked": { "$show": "(('%.11s' * #hud_title_text_string) = 'ixn:aaaaaaa')" } },
                  { "c7@ixs_hud.unchecked": { "$show": "(('%.12s' * #hud_title_text_string) = 'ixn:aaaaaaaa')" } },
                  { "c8@ixs_hud.unchecked": { "$show": "(('%.13s' * #hud_title_text_string) = 'ixn:aaaaaaaaa')" } },
                  { "c9@ixs_hud.unchecked": { "$show": "(('%.14s' * #hud_title_text_string) = 'ixn:aaaaaaaaaa')" } },
                  { "c10@ixs_hud.unchecked": { "$show": "(('%.15s' * #hud_title_text_string) = 'ixn:aaaaaaaaaaa')" } },
                  { "c11@ixs_hud.unchecked": { "$show": "(('%.16s' * #hud_title_text_string) = 'ixn:aaaaaaaaaaaa')" } }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "bundle_box@ixs_hud.frame": {
    "$box_rule": "(('%.4s' * #hud_title_text_string) = 'ixu:')",
    "controls": [
      {
        "column": {
          "type": "stack_panel", "orientation": "vertical", "size": [ "100%c", "100%c" ],
          "controls": [
            { "caption@ixs_hud.caption": { "$caption": "Hotbar slot 9: item, bundle data, stored amount" } },
            {
              "row": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ "100%c", 18 ], "collection_name": "hotbar_items",
                "controls": [
                  { "item@ixs_hud.live": { "$slot": 8 } },
                  {
                    "bundle_data": {
                      "type": "panel", "size": [ 18, 18 ], "collection_index": 8,
                      "controls": [
                        { "bg@ixs_hud.cell_bg": {} },
                        {
                          "icon": {
                            "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "layer": 2,
                            "bindings": [ { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#bundle_item_renderer_data", "binding_condition": "always" } ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "amount": {
                      "type": "label", "localize": false, "size": [ 30, 10 ], "collection_index": 8, "color": [ 1, 1, 0 ], "text": "#text",
                      "bindings": [ { "binding_type": "collection", "binding_collection_name": "hotbar_items", "binding_name": "#item_storage_current_amount", "binding_name_override": "#text", "binding_condition": "always" } ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 30,
    "controls": [
      { "backup_box@ixs_hud.backup_box": {} },
      { "lock_box@ixs_hud.lock_box": {} },
      { "counted_box@ixs_hud.counted_box": {} },
      { "unchecked_box@ixs_hud.unchecked_box": {} },
      { "bundle_box@ixs_hud.bundle_box": {} }
    ]
  }
}
