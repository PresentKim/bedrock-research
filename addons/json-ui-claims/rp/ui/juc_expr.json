{
  "namespace": "juc_expr",

  "row": {
    "type": "panel",
    "size": [ "100%", 7 ],
    "controls": [
      {
        "d": {
          "type": "label", "size": [ 58, 7 ], "anchor_from": "left_middle", "anchor_to": "left_middle",
          "font_scale_factor": 0.7, "localize": false, "color": [ 0.75, 0.75, 0.75 ], "text": "$d"
        }
      },
      {
        "r": {
          "type": "label", "size": [ 90, 7 ], "offset": [ 60, 0 ], "anchor_from": "left_middle", "anchor_to": "left_middle",
          "font_scale_factor": 0.7, "localize": false, "color": [ 1, 1, 0.4 ], "text": "#text",
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "$x", "target_property_name": "#text" }
          ]
        }
      }
    ]
  },

  "column": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 152, "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "collection_name": "form_buttons"
  },

  "col_a@juc_expr.column": {
    "controls": [
      { "a01@juc_expr.row": { "collection_index": 0, "$d": "a-b-a - 'a'", "$x": "(#v - 'a')" } },
      { "a02@juc_expr.row": { "collection_index": 1, "$d": "abab - 'ab'", "$x": "(#v - 'ab')" } },
      { "a03@juc_expr.row": { "collection_index": 0, "$d": "a-b-a - 'zz'", "$x": "(#v - 'zz')" } },
      { "a04@juc_expr.row": { "collection_index": 3, "$d": "' x' - zz", "$x": "(#v - 'zz')" } },
      { "a05@juc_expr.row": { "collection_index": 3, "$d": "[' x' - zz]", "$x": "(('[' + (#v - 'zz')) + ']')" } },
      { "a06@juc_expr.row": { "collection_index": 4, "$d": "'-x' - zz", "$x": "(#v - 'zz')" } },
      { "a07@juc_expr.row": { "collection_index": 5, "$d": "'+x' - zz", "$x": "(#v - 'zz')" } },
      { "a08@juc_expr.row": { "collection_index": 6, "$d": "':x' - zz", "$x": "(#v - 'zz')" } },
      { "a09@juc_expr.row": { "collection_index": 7, "$d": "'1x' - zz", "$x": "(#v - 'zz')" } },
      { "a10@juc_expr.row": { "collection_index": 8, "$d": "hash x - zz", "$x": "(#v - 'zz')" } },
      { "a11@juc_expr.row": { "collection_index": 9, "$d": "'/x' - zz", "$x": "(#v - 'zz')" } },
      { "a12@juc_expr.row": { "collection_index": 10, "$d": "'Info: a' - zz", "$x": "(#v - 'zz')" } },
      { "a13@juc_expr.row": { "collection_index": 11, "$d": "'nancy' - zz", "$x": "(#v - 'zz')" } },
      { "a14@juc_expr.row": { "collection_index": 12, "$d": "'0x12' - zz", "$x": "(#v - 'zz')" } },
      { "a15@juc_expr.row": { "collection_index": 24, "$d": "'inf' - zz", "$x": "(#v - 'zz')" } },
      { "a16@juc_expr.row": { "collection_index": 25, "$d": "'x' - zz", "$x": "(#v - 'zz')" } },
      { "a17@juc_expr.row": { "collection_index": 3, "$d": "'' + ' x'", "$x": "('' + #v)" } },
      { "a18@juc_expr.row": { "collection_index": 7, "$d": "'' + '1x'", "$x": "('' + #v)" } },
      { "a19@juc_expr.row": { "collection_index": 10, "$d": "'' + 'Info: a'", "$x": "('' + #v)" } },
      { "a20@juc_expr.row": { "collection_index": 12, "$d": "'' + '0x12'", "$x": "('' + #v)" } },
      { "a21@juc_expr.row": { "collection_index": 7, "$d": "'§r' + '1x'", "$x": "('§r' + #v)" } },
      { "a22@juc_expr.row": { "collection_index": 7, "$d": "'z' + '1x'", "$x": "('z' + #v)" } },
      { "a23@juc_expr.row": { "collection_index": 9, "$d": "'z' + '/x'", "$x": "('z' + #v)" } },
      { "a24@juc_expr.row": { "collection_index": 26, "$d": "'<x' - zz", "$x": "(#v - 'zz')" } }
    ]
  },

  "col_b@juc_expr.column": {
    "offset": [ 152, 0 ],
    "controls": [
      { "b01@juc_expr.row": { "collection_index": 13, "$d": "§cAB %.1s", "$x": "(('[' + ('%.1s' * #v)) + ']')" } },
      { "b02@juc_expr.row": { "collection_index": 13, "$d": "§cAB %.2s", "$x": "(('[' + ('%.2s' * #v)) + ']')" } },
      { "b03@juc_expr.row": { "collection_index": 13, "$d": "§cAB %.3s", "$x": "(('[' + ('%.3s' * #v)) + ']')" } },
      { "b04@juc_expr.row": { "collection_index": 13, "$d": "§cAB %.4s", "$x": "(('[' + ('%.4s' * #v)) + ']')" } },
      { "b05@juc_expr.row": { "collection_index": 14, "$d": "KR3 %.2s", "$x": "(('[' + ('%.2s' * #v)) + ']')" } },
      { "b06@juc_expr.row": { "collection_index": 14, "$d": "KR3 %.3s", "$x": "(('[' + ('%.3s' * #v)) + ']')" } },
      { "b07@juc_expr.row": { "collection_index": 14, "$d": "KR3 %.4s", "$x": "(('[' + ('%.4s' * #v)) + ']')" } },
      { "b08@juc_expr.row": { "collection_index": 14, "$d": "KR3 %.6s", "$x": "(('[' + ('%.6s' * #v)) + ']')" } },
      { "b09@juc_expr.row": { "collection_index": 15, "$d": "emoji %.2s", "$x": "(('[' + ('%.2s' * #v)) + ']')" } },
      { "b10@juc_expr.row": { "collection_index": 15, "$d": "emoji %.4s", "$x": "(('[' + ('%.4s' * #v)) + ']')" } },
      { "b11@juc_expr.row": { "collection_index": 15, "$d": "emoji %.5s", "$x": "(('[' + ('%.5s' * #v)) + ']')" } },
      { "b12@juc_expr.row": { "collection_index": 16, "$d": "abcdef %7.4s", "$x": "(('[' + ('%7.4s' * #v)) + ']')" } },
      { "b13@juc_expr.row": { "collection_index": 16, "$d": "abcdef %-7.4s", "$x": "(('[' + ('%-7.4s' * #v)) + ']')" } },
      { "b14@juc_expr.row": { "collection_index": 16, "$d": "abcdef %9s", "$x": "(('[' + ('%9s' * #v)) + ']')" } },
      { "b15@juc_expr.row": { "collection_index": 16, "$d": "abcdef %-9s", "$x": "(('[' + ('%-9s' * #v)) + ']')" } },
      { "b16@juc_expr.row": { "collection_index": 16, "$d": "abcdef %09s", "$x": "(('[' + ('%09s' * #v)) + ']')" } },
      { "b17@juc_expr.row": { "collection_index": 16, "$d": "abcdef %4.2s", "$x": "(('[' + ('%4.2s' * #v)) + ']')" } },
      { "b18@juc_expr.row": { "collection_index": 16, "$d": "abcdef %.4s", "$x": "(('[' + ('%.4s' * #v)) + ']')" } },
      { "b19@juc_expr.row": { "collection_index": 16, "$d": "lit %.3s + v-v", "$x": "(('%.3s' * 'abcdef') + (#v - #v))" } },
      { "b20@juc_expr.row": { "collection_index": 16, "$d": "lit %.3s alone", "$x": "('%.3s' * 'abcdef')" } },
      { "b21@juc_expr.row": { "collection_index": 23, "$d": "fmt from v=3", "$x": "(('%.' + #v + 's') * 'abcdef')" } },
      { "b22@juc_expr.row": { "collection_index": 16, "$d": "fmt from $n=3", "$n": 3, "$x": "(('%.' + $n + 's') * #v)" } },
      { "b23@juc_expr.row": { "collection_index": 16, "$d": "fmt from '3'", "$x": "(('%.' + '3' + 's') * #v)" } },
      { "b24@juc_expr.row": { "collection_index": 22, "$d": "translate(k, v)", "$x": "(translate('gui.ok', #v))" } }
    ]
  },

  "col_c@juc_expr.column": {
    "offset": [ 304, 0 ],
    "controls": [
      { "c01@juc_expr.row": { "collection_index": 17, "$d": "17 % 5", "$x": "('R' + ((#v - 0) % 5))" } },
      { "c02@juc_expr.row": { "collection_index": 17, "$d": "17 - 17/5*5", "$x": "('R' + ((#v - 0) - (((#v - 0) / 5) * 5)))" } },
      { "c03@juc_expr.row": { "collection_index": 17, "$d": "17 / 5", "$x": "('R' + ((#v - 0) / 5))" } },
      { "c04@juc_expr.row": { "collection_index": 18, "$d": "-7 / 3", "$x": "('R' + ((#v - 0) / 3))" } },
      { "c05@juc_expr.row": { "collection_index": 18, "$d": "-7 - -7/3*3", "$x": "('R' + ((#v - 0) - (((#v - 0) / 3) * 3)))" } },
      { "c06@juc_expr.row": { "collection_index": 18, "$d": "-7 % 3", "$x": "('R' + ((#v - 0) % 3))" } },
      { "c07@juc_expr.row": { "collection_index": 19, "$d": "4 * 2", "$x": "('R' + ((#v - 0) * 2))" } },
      { "c08@juc_expr.row": { "collection_index": 19, "$d": "4 * $two", "$two": 2, "$x": "('R' + ((#v - 0) * $two))" } },
      { "c09@juc_expr.row": { "collection_index": 19, "$d": "'4' * 1", "$x": "('R' + (#v * 1))" } },
      { "c10@juc_expr.row": { "collection_index": 19, "$d": "s4 * 1, + 1", "$x": "('R' + ((#v * 1) + 1))" } },
      { "c11@juc_expr.row": { "collection_index": 19, "$d": "'4' - 0", "$x": "('R' + (#v - 0))" } },
      { "c12@juc_expr.row": { "collection_index": 19, "$d": "'4' + $zero(0.0)", "$zero": 0.0, "$x": "('R' + (#v + $zero))" } },
      { "c13@juc_expr.row": { "collection_index": 19, "$d": "s4 + $zero, + 1", "$zero": 0.0, "$x": "('R' + ((#v + $zero) + 1))" } },
      { "c14@juc_expr.row": { "collection_index": 20, "$d": "10 * 0.3", "$x": "('R' + ((#v - 0) * 0.3))" } },
      { "c15@juc_expr.row": { "collection_index": 20, "$d": "10 * .3", "$x": "('R' + ((#v - 0) * .3))" } },
      { "c16@juc_expr.row": { "collection_index": 20, "$d": "10 * 1.5", "$x": "('R' + ((#v - 0) * 1.5))" } },
      { "c17@juc_expr.row": { "collection_index": 20, "$d": "10 / 4", "$x": "('R' + ((#v - 0) / 4))" } },
      { "c18@juc_expr.row": { "collection_index": 20, "$d": "5 < 10 < 7", "$x": "('R' + (5 < (#v - 0) < 7))" } },
      { "c19@juc_expr.row": { "collection_index": 20, "$d": "5<10 and 10<7", "$x": "('R' + ((5 < (#v - 0)) and ((#v - 0) < 7)))" } },
      { "c19b@juc_expr.row": { "collection_index": 20, "$d": "10>5 and 10<17", "$x": "('R' + (((#v - 0) > 5) and ((#v - 0) < 17)))" } },
      { "c20@juc_expr.row": { "collection_index": 20, "$d": "not (10 < 10)", "$x": "('R' + (not ((#v - 0) < 10)))" } },
      { "c21@juc_expr.row": { "collection_index": 20, "$d": "10 >= 10", "$x": "('R' + ((#v - 0) >= 10))" } },
      { "c22@juc_expr.row": { "collection_index": 2, "$d": "'5' != '5'", "$x": "('R' + (#v != '5'))" } },
      { "c23@juc_expr.row": { "collection_index": 2, "$d": "not ('5' = '5')", "$x": "('R' + (not (#v = '5')))" } },
      { "c24@juc_expr.row": { "collection_index": 22, "$d": "'b' < 'c'", "$x": "('R' + (#v < 'c'))" } },
      { "c25@juc_expr.row": { "collection_index": 22, "$d": "'b' > 'c'", "$x": "('R' + (#v > 'c'))" } },
      { "c26@juc_expr.row": { "collection_index": 22, "$d": "'b' < 'a'", "$x": "('R' + (#v < 'a'))" } },
      { "c27@juc_expr.row": { "collection_index": 21, "$d": "INT_MAX + 1", "$x": "('R' + ((#v - 0) + 1))" } },
      { "c28@juc_expr.row": { "collection_index": 19, "$d": "s4 - 0, = 4", "$x": "('R' + ((#v - 0) = 4))" } },
      { "c29@juc_expr.row": { "collection_index": 19, "$d": "s4 * 1, = 4", "$x": "('R' + ((#v * 1) = 4))" } },
      { "c31@juc_expr.row": { "collection_index": 27, "$d": "xaxbx - 'x'", "$x": "('R' + (#v - 'x'))" } },
      { "c34@juc_expr.row": { "collection_index": 19, "$d": "s4 + 1", "$x": "('R' + (#v + 1))" } },
      { "c35@juc_expr.row": { "collection_index": 20, "$d": "10 * .3, = 3", "$x": "('R' + (((#v - 0) * .3) = 3))" } },
      { "c36@juc_expr.row": { "collection_index": 20, "$d": "10 * .5, * 2", "$x": "('R' + (((#v - 0) * .5) * 2))" } }
    ]
  },

  "window": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 20,
    "$window_title": "P1 expressions",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      {
        "body": {
          "type": "panel", "layer": 2, "size": [ "100% - 8px", "100% - 16px" ], "offset": [ 4, 14 ],
          "anchor_from": "top_left", "anchor_to": "top_left",
          "controls": [
            { "col_a@juc_expr.col_a": {} },
            { "col_b@juc_expr.col_b": {} },
            { "col_c@juc_expr.col_c": {} }
          ]
        }
      }
    ]
  }
}
