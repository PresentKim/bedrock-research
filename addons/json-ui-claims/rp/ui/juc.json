{
  "namespace": "juc",

  "bg": { "type": "image", "texture": "textures/ui/Black", "alpha": 0.85, "size": [ "100%", "100%" ] },

  "title": {
    "type": "label", "layer": 2, "localize": false, "color": [ 1, 1, 1 ],
    "offset": [ 4, 2 ], "anchor_from": "top_left", "anchor_to": "top_left", "size": [ "default", 10 ],
    "text": "$window_title"
  },

  "screen_router": {
    "type": "collection_panel",
    "size": [ "100%", "100%" ],
    "factory": {
      "name": "juc_screen",
      "control_ids": { "p1": "@juc_expr.window", "p2": "@juc_lay.window", "p3": "@juc_files.window", "p4": "@juc_forms.window", "p5": "@juc_forms.window5", "p6": "@juc_forms.window6", "p7": "@juc_expr.window7", "pk": "@juc_keys.window_default", "pl": "@juc_keys.window_false", "pn": "@juc_keys.window_true","pa": "@juc_lay.win_images", "pb": "@juc_lay.win_texture", "pc": "@juc_lay.win_clip", "pd": "@juc_lay.win_noclip", "pe": "@juc_lay.win_parse", "pf": "@juc_lay.win_plain", "pt": "@juc_t.window" }
    },
    "property_bag": { "#§b§wjc:a": [ "pa" ], "#§b§wjc:b": [ "pb" ], "#§b§wjc:c": [ "pc" ], "#§b§wjc:d": [ "pd" ], "#§b§wjc:e": [ "pe" ], "#§b§wjc:f": [ "pf" ], "#§b§wjc:6": [ "p6" ], "#§b§wjc:7": [ "p7" ], "#§b§wjc:k": [ "pk" ], "#§b§wjc:l": [ "pl" ], "#§b§wjc:n": [ "pn" ],"#§b§wjc:1": [ "p1" ], "#§b§wjc:2": [ "p2" ], "#§b§wjc:3": [ "p3" ], "#§b§wjc:4": [ "p4" ], "#§b§wjc:5": [ "p5" ], "#§b§wjc:t": [ "pt" ] },
    "bindings": [
      { "binding_name": "#title_text" },
      { "binding_type": "view", "source_property_name": "('#' + ('%.10s' * #title_text))", "target_property_name": "#collection_length" }
    ]
  }
}
