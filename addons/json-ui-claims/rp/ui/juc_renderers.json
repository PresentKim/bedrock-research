{
  "namespace": "juc_rn",

  "f": { "type": "image", "texture": "textures/ui/White", "alpha": 0.15, "size": [ "100%", "100%" ] },

  "cap": {
    "type": "label", "localize": false, "color": [ 1, 1, 0.4 ], "size": [ "default", 10 ],
    "anchor_from": "top_left", "anchor_to": "top_left"
  },

  "v": {
    "type": "label", "localize": false, "color": [ 1, 1, 1 ], "size": [ "default", 10 ],
    "anchor_from": "top_left", "anchor_to": "top_left",
    "text": "#text",
    "bindings": [ { "binding_type": "view", "binding_condition": "always", "source_control_name": "$src_control", "source_property_name": "$src", "target_property_name": "#text" } ]
  },

  "box": {
    "type": "panel", "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [ { "frame@juc_rn.f": {} } ]
  },

  "dot": { "type": "image", "texture": "textures/ui/White", "color": [ 1, 0, 0 ], "size": [ 2, 2 ], "anchor_from": "top_left", "anchor_to": "top_left" },

  "fly_section": {
    "type": "panel", "size": [ 236, 110 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "fly_cap@juc_rn.cap": { "text": "flying_item" } },
      { "fly_ref": { "type": "custom", "renderer": "inventory_item_renderer", "size": [ 16, 16 ], "offset": [ 0, 12 ], "anchor_from": "top_left", "anchor_to": "top_left", "property_bag": { "#item_id_aux": 65536 } } },
      { "fly_d1@juc_rn.dot": { "offset": [ 20, 40 ] } },
      { "fly_d2@juc_rn.dot": { "offset": [ 200, 40 ] } },
      { "fly_d3@juc_rn.dot": { "offset": [ 20, 60 ] } },
      { "fly_d4@juc_rn.dot": { "offset": [ 200, 100 ] } },
      { "fly_static@juc_rn.box": { "size": [ 10, 10 ], "offset": [ 120, 12 ], "controls": [
        { "fly_static_r": { "type": "custom", "renderer": "flying_item_renderer", "layer": 40, "size": [ "100%", "100%" ],
          "property_bag": {
            "flying_item_count": 1, "flying_item_id_aux0": 65536,
            "flying_item_origin_position_x0": 20, "flying_item_origin_position_y0": 40,
            "flying_item_destination_position_x0": 200, "flying_item_destination_position_y0": 40
          } } }
      ] } },
      { "fly_stream@juc_rn.box": { "size": [ 10, 10 ], "offset": [ 140, 12 ], "controls": [
        { "fly_stream_r": { "type": "custom", "renderer": "flying_item_renderer", "layer": 40, "size": [ "100%", "100%" ],
          "property_bag": {
            "#one": 1, "flying_item_id_aux0": 65536,
            "flying_item_origin_position_x0": 20, "flying_item_origin_position_y0": 60, "flying_item_origin_scale0": 1,
            "flying_item_destination_position_x0": 200, "flying_item_destination_position_y0": 100, "flying_item_destination_scale0": 3
          },
          "bindings": [ { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#one)", "target_property_name": "flying_item_count" } ] } }
      ] } }
    ]
  },

  "pano": {
    "type": "custom", "renderer": "panorama_renderer", "size": [ 60, 20 ],
    "anchor_from": "top_left", "anchor_to": "top_left",
    "property_bag": { "#texture": "textures/ui/title" }
  },

  "pano_section": {
    "type": "panel", "size": [ 236, 110 ], "offset": [ 236, 0 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "pano_cap@juc_rn.cap": { "text": "panorama: a -5000, b +5000, c drag, d texture key only" } },
      { "pano_a@juc_rn.pano": { "offset": [ 0, 12 ], "texture": "textures/ui/title", "property_bag": { "#texture": "textures/ui/title", "#uv_offset_x": -5000 } } },
      { "pano_a_v@juc_rn.v": { "offset": [ 104, 17 ], "$src_control": "pano_a", "$src": "('a L=' + #can_scroll_left + ' R=' + #can_scroll_right)" } },
      { "pano_b@juc_rn.pano": { "offset": [ 0, 36 ], "texture": "textures/ui/title", "property_bag": { "#texture": "textures/ui/title", "#uv_offset_x": 5000 } } },
      { "pano_b_v@juc_rn.v": { "offset": [ 104, 41 ], "$src_control": "pano_b", "$src": "('b L=' + #can_scroll_left + ' R=' + #can_scroll_right)" } },
      { "pano_c_in": { "type": "input_panel", "size": [ 60, 20 ], "offset": [ 0, 60 ], "anchor_from": "top_left", "anchor_to": "top_left",
        "gesture_tracking_button": "button.scroll_map",
        "button_mappings": [ { "from_button_id": "button.menu_select", "to_button_id": "button.scroll_map", "mapping_type": "pressed", "button_up_right_of_first_refusal": true } ],
        "controls": [
          { "pano_c@juc_rn.pano": { "offset": [ 0, 0 ], "texture": "textures/ui/title",
            "bindings": [ { "binding_type": "view", "source_control_name": "pano_c_in", "source_property_name": "#gesture_mouse_delta_x", "target_property_name": "#gesture_mouse_delta_x" } ] } }
        ] } },
      { "pano_c_v@juc_rn.v": { "offset": [ 104, 65 ], "$src_control": "pano_c", "$src": "('c L=' + #can_scroll_left + ' R=' + #can_scroll_right)" } },
      { "pano_d@juc_rn.pano": { "offset": [ 0, 84 ], "texture": "textures/ui/title", "property_bag": {} } },
      { "pano_d_v@juc_rn.v": { "offset": [ 104, 89 ], "$src_control": "pano_d", "$src": "('d L=' + #can_scroll_left + ' R=' + #can_scroll_right)" } },
      { "pano_e": { "type": "image", "texture": "textures/ui/title", "size": [ 60, 10 ], "offset": [ 170, 96 ], "anchor_from": "top_left", "anchor_to": "top_left" } }
    ]
  },

  "ban": { "type": "custom", "renderer": "banner_pattern_renderer", "size": [ 20, 40 ], "anchor_from": "top_left", "anchor_to": "top_left" },

  "ban_section": {
    "type": "panel", "size": [ 236, 120 ], "offset": [ 0, 112 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "ban_cap@juc_rn.cap": { "text": "banner: 0_5_ | 0_5 | 0_ | 0_1_2_3_ | 5_ | 1_2_ | empty" } },
      { "ban1@juc_rn.ban": { "offset": [ 0, 12 ], "property_bag": { "#banner_patterns": "0_5_", "#banner_colors": "15_1_" } } },
      { "ban2@juc_rn.ban": { "offset": [ 24, 12 ], "property_bag": { "#banner_patterns": "0_5", "#banner_colors": "15_1" } } },
      { "ban3@juc_rn.ban": { "offset": [ 48, 12 ], "property_bag": { "#banner_patterns": "0_", "#banner_colors": "14_" } } },
      { "ban4@juc_rn.ban": { "offset": [ 72, 12 ], "property_bag": { "#banner_patterns": "0_1_2_3_", "#banner_colors": "15_14_11_4_" } } },
      { "ban5@juc_rn.ban": { "offset": [ 96, 12 ], "property_bag": { "#banner_patterns": "5_", "#banner_colors": "1_" } } },
      { "ban6@juc_rn.ban": { "offset": [ 120, 12 ], "property_bag": { "#banner_patterns": "1_2_", "#banner_colors": "4_" } } },
      { "ban7@juc_rn.ban": { "offset": [ 144, 12 ], "property_bag": { "#banner_patterns": "", "#banner_colors": "" } } },
      { "ban8@juc_rn.ban": { "offset": [ 168, 12 ], "size": [ 40, 80 ], "property_bag": { "#banner_patterns": "0_6_", "#banner_colors": "0_14_" } } },
      { "ban_frame@juc_rn.box": { "size": [ 20, 40 ], "offset": [ 0, 56 ] } },
      { "ban9@juc_rn.ban": { "offset": [ 0, 56 ], "property_bag": { "#banner_patterns": "0_5_", "#banner_colors": "15_1_" } } }
    ]
  },

  "slots_section": {
    "type": "panel", "size": [ 236, 120 ], "offset": [ 236, 112 ], "anchor_from": "top_left", "anchor_to": "top_left",
    "controls": [
      { "slots_cap@juc_rn.cap": { "text": "hotbar_slots: frame 60x30 at (40,30)" } },
      { "slots_box@juc_rn.box": { "size": [ 60, 30 ], "offset": [ 40, 30 ], "controls": [
        { "slots_r": { "type": "custom", "renderer": "hotbar_slots_renderer", "size": [ "100%", "100%" ] } }
      ] } }
    ]
  },

  "window": {
    "type": "panel", "size": [ "100%", "100%" ], "layer": 20,
    "$window_title": "Renderer probes",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      { "r_body": {
        "type": "panel", "layer": 2, "size": [ "100% - 8px", "100% - 16px" ], "offset": [ 4, 14 ],
        "anchor_from": "top_left", "anchor_to": "top_left",
        "controls": [
          { "fly@juc_rn.fly_section": {} },
          { "pano@juc_rn.pano_section": {} },
          { "ban@juc_rn.ban_section": {} },
          { "slots@juc_rn.slots_section": {} }
        ]
      } }
    ]
  },

  "window_debug": {
    "type": "panel", "size": [ "100%", "100%" ], "layer": 20,
    "$window_title": "debug_screen_renderer: frame 200x100 at (40,40)",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      { "dbg_box@juc_rn.box": { "layer": 2, "size": [ 200, 100 ], "offset": [ 40, 40 ], "controls": [
        { "dbg_r": { "type": "custom", "renderer": "debug_screen_renderer", "size": [ "100%", "100%" ] } }
      ] } }
    ]
  },

  "doll_r": {
    "type": "custom", "renderer": "paper_doll_renderer", "size": [ "100%", "100% - 12px" ],
    "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "layer": 2
  },

  "window_doll": {
    "type": "panel", "size": [ "100%", "100%" ], "layer": 20,
    "$window_title": "paper_doll probes",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      { "u_body": {
        "type": "panel", "layer": 2, "size": [ "100% - 8px", "100% - 16px" ], "offset": [ 4, 14 ],
        "anchor_from": "top_left", "anchor_to": "top_left",
        "controls": [
          { "d1": { "type": "panel", "size": [ 70, 110 ], "offset": [ 0, 0 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "base" } },
            { "doll_base@juc_rn.doll_r": {} } ] } },
          { "d2": { "type": "panel", "size": [ 70, 110 ], "offset": [ 76, 0 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "head_follow" } },
            { "doll_hf@juc_rn.doll_r": { "rotation": "custom_y_head_follow_mouse" } } ] } },
          { "d3": { "type": "panel", "size": [ 70, 110 ], "offset": [ 152, 0 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "custom_y" } },
            { "doll_cy@juc_rn.doll_r": { "rotation": "custom_y" } } ] } },
          { "d4": { "type": "panel", "size": [ 70, 110 ], "offset": [ 228, 0 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "auto" } },
            { "doll_auto@juc_rn.doll_r": { "rotation": "auto" } } ] } },
          { "d5": { "type": "panel", "size": [ 70, 110 ], "offset": [ 0, 116 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "shrink" } },
            { "doll_shrink@juc_rn.doll_r": { "shrink_to_fit": true } } ] } },
          { "d6": { "type": "panel", "size": [ 140, 110 ], "offset": [ 76, 116 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "shrink wide 140" } },
            { "doll_shrink_w@juc_rn.doll_r": { "shrink_to_fit": true } } ] } },
          { "d7": { "type": "panel", "size": [ 140, 110 ], "offset": [ 222, 116 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "no shrink wide 140" } },
            { "doll_wide@juc_rn.doll_r": {} } ] } },
          { "d8": { "type": "panel", "size": [ 70, 110 ], "offset": [ 304, 0 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "coco" } },
            { "doll_coco@juc_rn.doll_r": { "show_persona_coco": true } } ] } },
          { "d9": { "type": "panel", "size": [ 70, 110 ], "offset": [ 380, 0 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "coco no sel" } },
            { "doll_coco2@juc_rn.doll_r": { "show_persona_coco": true, "use_selected_skin": false } } ] } },
          { "d10": { "type": "panel", "size": [ 40, 50 ], "offset": [ 370, 116 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "s40" } },
            { "doll_small_s@juc_rn.doll_r": { "shrink_to_fit": true } } ] } },
          { "d11": { "type": "panel", "size": [ 40, 50 ], "offset": [ 420, 116 ], "anchor_from": "top_left", "anchor_to": "top_left", "controls": [
            { "f@juc_rn.f": {} }, { "c@juc_rn.cap": { "text": "n40" } },
            { "doll_small_n@juc_rn.doll_r": {} } ] } }
        ]
      } }
    ]
  }
}
