  "value_rows": {
    "type": "stack_panel",
    "size": [ 250, "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 210, 100 ],
    "controls": [
      { "r1@juc_t.v": { "$src": "('E10=' + 3000000000 + '|' + (#one - #one))" } },
      { "r2@juc_t.v": { "$src": "('E11=' + (1 AND 1) + (#one - #one))" } },
      { "r3@juc_t.v": { "$src": "('E11b=' + (1 and 1) + (#one - #one))" } },
      { "r4@juc_t.v": { "$src": "('E8=' + ('abc' > 0) + (#one - #one))" } },
      { "r5@juc_t.v": { "$src": "('E9=' + (5 = true) + '|' + (16777217 = 16777216) + (#one - #one))" } },
      { "r6@juc_t.v": { "$src": "('U1=' + (+'abc') + (#one - #one))" } },
      { "r6b@juc_t.v": { "$src": "('U2=' + (+(#one = 1)) + (#one - #one))" } },
      { "r6c@juc_t.v": { "$src": "('U3=' + (-#one) + '|' + (+#one) + (#one - #one))" } },
      { "r6d@juc_t.v": { "$src": "('G=' + (#one #one) + (#one - #one))" } },
      { "r7@juc_t.v": { "$src": "('D=' + ((#one = 1) / 0) + '|' + (5 / 'a') + (#one - #one))" } },
      { "r8@juc_t.v": { "$v": "#one", "$src": "('V=' + (#one + $v) + (#one - #one))" } },
      { "r9": { "type": "label", "localize": false, "size": [ "default", 10 ], "text": "#text", "bindings": [ { "binding_name": "('#title' + '_text')", "binding_name_override": "#text" } ] } },
      { "r10": { "type": "label", "localize": false, "size": [ "default", 10 ], "text": "#title_text", "bindings": [ { "binding_name": "(not #title_text)" } ] } },
      { "r11": { "type": "label", "localize": false, "size": [ 30, 10 ], "text": "abcdefghijklmnopqrstuvwxyz", "color": [ 1, 1, 1 ] } },
      { "r12": { "type": "label", "localize": false, "size": [ "default", 10 ], "text": "§cRed§lBold§aGreenStillBold§rN §CUpper", "shadow": true } }
    ]
  },

