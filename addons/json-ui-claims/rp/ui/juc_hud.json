{
  "namespace": "juc_hud",

  "reader": {
    "type": "label", "size": [ 200, 8 ], "font_scale_factor": 0.8, "localize": false, "color": [ 1, 1, 0.4 ], "text": "#text",
    "anchor_from": "top_left", "anchor_to": "top_left"
  },

  "anim_a": { "anim_type": "alpha", "easing": "linear", "duration": 1, "from": 1, "to": 0, "destroy_at_end": "juc_d_inst_a" },

  "dprobe_plain": {
    "type": "panel", "size": [ 4, 4 ],
    "controls": [ { "img": { "type": "image", "texture": "textures/ui/White", "size": [ 4, 4 ] } } ]
  },

  "anim_b": { "anim_type": "alpha", "easing": "linear", "duration": 1, "from": 1, "to": 0, "destroy_at_end": "dprobe_b" },
  "anim_c": { "anim_type": "alpha", "easing": "linear", "duration": 1, "from": 1, "to": 0, "destroy_at_end": "hud_title_text" },

  "dprobe_b": {
    "type": "panel", "size": [ 4, 4 ],
    "controls": [ { "img": { "type": "image", "texture": "textures/ui/White", "size": [ 4, 4 ], "alpha": "@juc_hud.anim_b" } } ]
  },

  "dprobe_c": {
    "type": "panel", "size": [ 4, 4 ],
    "controls": [ { "img": { "type": "image", "texture": "textures/ui/White", "size": [ 4, 4 ], "alpha": "@juc_hud.anim_c" } } ]
  },

  "dprobe_a": {
    "type": "panel", "size": [ 4, 4 ],
    "controls": [ { "img": { "type": "image", "texture": "textures/ui/White", "size": [ 4, 4 ], "alpha": "@juc_hud.anim_a" } } ]
  },

  "host": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "juc_latch": {
          "type": "panel",
          "size": [ 0, 0 ],
          "property_bag": { "#saved": "" },
          "bindings": [
            { "binding_name": "#hud_title_text_string" },
            { "binding_name": "#hud_title_text_string", "binding_name_override": "#saved", "binding_condition": "visibility_changed" },
            {
              "binding_type": "view",
              "source_property_name": "((not ((#hud_title_text_string - 'JUC') = #hud_title_text_string)) and (not (#hud_title_text_string = #saved)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "juc_saved@juc_hud.reader": {
          "offset": [ 4, 40 ],
          "bindings": [
            { "binding_type": "view", "source_control_name": "juc_latch", "source_property_name": "('saved: ' + #saved)", "target_property_name": "#text" }
          ]
        }
      },
      {
        "juc_now@juc_hud.reader": {
          "offset": [ 4, 50 ],
          "bindings": [
            { "binding_name": "#hud_title_text_string" },
            { "binding_type": "view", "source_property_name": "('now: ' + #hud_title_text_string)", "target_property_name": "#text" }
          ]
        }
      },
      {
        "juc_gate_parent": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "bindings": [
            { "binding_name": "#hud_actionbar_text_string" },
            { "binding_type": "view", "source_property_name": "(not (#hud_actionbar_text_string = 'off'))", "target_property_name": "#visible" }
          ],
          "controls": [
            {
              "juc_latch2": {
                "type": "panel",
                "size": [ 0, 0 ],
                "property_bag": { "#saved": "" },
                "bindings": [
                  { "binding_name": "#hud_title_text_string" },
                  { "binding_name": "#hud_title_text_string", "binding_name_override": "#saved", "binding_condition": "visibility_changed" },
                  {
                    "binding_type": "view",
                    "source_property_name": "((not ((#hud_title_text_string - 'JUC') = #hud_title_text_string)) and (not (#hud_title_text_string = #saved)))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "juc_saved2@juc_hud.reader": {
          "offset": [ 4, 60 ],
          "bindings": [
            { "binding_type": "view", "source_control_name": "juc_latch2", "source_property_name": "('child latch: ' + #saved)", "target_property_name": "#text" }
          ]
        }
      },
      {
        "juc_d_host_p": {
          "type": "panel", "size": [ "100%", "100%" ],
          "factory": { "name": "hud_title_text_factory", "control_ids": { "hud_title_text": "juc_d_inst_p@juc_hud.dprobe_plain" } }
        }
      },
      {
        "juc_d_host_a": {
          "type": "panel", "size": [ "100%", "100%" ],
          "factory": { "name": "hud_title_text_factory", "control_ids": { "hud_title_text": "juc_d_inst_a@juc_hud.dprobe_a" } }
        }
      },
      {
        "juc_d_host_b": {
          "type": "panel", "size": [ "100%", "100%" ],
          "factory": { "name": "hud_title_text_factory", "control_ids": { "hud_title_text": "juc_d_inst_b@juc_hud.dprobe_b" } }
        }
      },
      {
        "juc_d_host_c": {
          "type": "panel", "size": [ "100%", "100%" ],
          "factory": { "name": "hud_title_text_factory", "control_ids": { "hud_title_text": "juc_d_inst_c@juc_hud.dprobe_c" } }
        }
      }
    ]
  }
}
