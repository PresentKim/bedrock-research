{
  "namespace": "juc_files",

  "reader": {
    "type": "label",
    "size": [ 60, 8 ],
    "font_scale_factor": 0.7,
    "localize": false,
    "color": [ 1, 1, 0.4 ],
    "text": "#text",
    "$resolve_sibling|default": false,
    "$resolve_ancestor|default": false,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$source",
        "resolve_sibling_scope": "$resolve_sibling",
        "resolve_ancestor_scope": "$resolve_ancestor",
        "source_property_name": "$prop",
        "target_property_name": "#text"
      }
    ]
  },

  "source": { "type": "panel", "size": [ 2, 2 ] },

  "scope_panel": {
    "type": "stack_panel",
    "size": [ 150, "100%c" ],
    "property_bag": { "#pa": "ANC" },
    "controls": [
      { "src_sib@juc_files.source": { "property_bag": { "#pv": "SIB" } } },
      { "sib_plain@juc_files.reader": { "$source": "src_sib", "$prop": "#pv" } },
      { "sib_flag@juc_files.reader": { "$source": "src_sib", "$prop": "#pv", "$resolve_sibling": true } },
      {
        "box_a": {
          "type": "stack_panel", "size": [ "100%", "100%c" ],
          "controls": [ { "src_cousin@juc_files.source": { "property_bag": { "#pc": "COUSIN" } } } ]
        }
      },
      {
        "box_b": {
          "type": "stack_panel", "size": [ "100%", "100%c" ],
          "controls": [
            { "cousin_plain@juc_files.reader": { "$source": "src_cousin", "$prop": "#pc" } },
            { "cousin_flag@juc_files.reader": { "$source": "src_cousin", "$prop": "#pc", "$resolve_sibling": true } },
            { "anc_plain@juc_files.reader": { "$source": "scope", "$prop": "#pa" } },
            { "anc_flag@juc_files.reader": { "$source": "scope", "$prop": "#pa", "$resolve_ancestor": true } },
            { "far_plain@juc_files.reader": { "$source": "src_far", "$prop": "#pf" } }
          ]
        }
      }
    ]
  },

  "window": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 20,
    "$window_title": "P3 files and modifications",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      { "src_far@juc_files.source": { "property_bag": { "#pf": "FAR" } } },
      {
        "body": {
          "type": "stack_panel", "layer": 2, "size": [ 200, "100%c" ], "offset": [ 4, 14 ],
          "anchor_from": "top_left", "anchor_to": "top_left",
          "controls": [
            {
              "tp@thanks_for_testing.text_panel": {
                "size": [ 100, "100%c" ],
                "$title_text": "TITLE",
                "$description_text": "DESC",
                "$description_text_line_2": "DESC2",
                "$multiline_description": true,
                "$main_header_text_color": [ 1, 1, 1 ],
                "$body_text_color": [ 0.8, 0.8, 0.8 ]
              }
            },
            {
              "errs": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ 100, 10 ],
                "controls": [
                  { "ea@juc_err.a": {} },
                  { "ebroken@juc_err.broken": {} },
                  { "eb@juc_err.b": {} }
                ]
              }
            },
            {
              "dups": {
                "type": "panel", "size": [ 100, 20 ],
                "controls": [
                  { "dup": { "type": "panel", "size": [ 10, 10 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
                  { "dup": { "type": "panel", "size": [ 20, 20 ], "anchor_from": "top_right", "anchor_to": "top_right" } }
                ]
              }
            },
            { "sp@juc_split.outer": {} },
            { "scope@juc_files.scope_panel": {} }
          ]
        }
      }
    ]
  }
}
