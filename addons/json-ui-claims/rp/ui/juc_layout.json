{
  "namespace": "juc_lay",

  "fill": { "type": "image", "texture": "textures/ui/White", "alpha": 0.35 },

  "box": {
    "type": "panel",
    "size": [ 100, 40 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [ { "frame@juc_lay.fill": { "size": [ "100%", "100%" ], "alpha": 0.12 } } ]
  },

  "cell": {
    "type": "panel",
    "size": [ 10, 10 ],
    "controls": [ { "f@juc_lay.fill": { "size": [ "100%", "100%" ] } } ]
  },

  "value_reader": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [ { "f@juc_lay.fill": { "size": [ "100%", "100%" ] } } ]
  },

  "hideable": {
    "type": "panel",
    "size": [ 10, 10 ],
    "$hide|default": false,
    "ignored": "$hide"
  },

  "grid_cell": {
    "type": "panel",
    "size": [ 20, 10 ],
    "controls": [ { "f@juc_lay.fill": { "size": [ "100% - 2px", "100%" ] } } ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(not (#v = 'hide'))", "target_property_name": "#visible" }
    ]
  },

  "body": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "def_panel_box@juc_lay.box": {
          "offset": [ 0, 0 ],
          "controls": [ { "t": { "type": "panel", "size": [ "default", "default" ], "controls": [ { "f@juc_lay.fill": { "size": [ "100%", "100%" ] } } ] } } ]
        }
      },
      {
        "def_label_box@juc_lay.box": {
          "offset": [ 105, 0 ],
          "controls": [ { "t": { "type": "label", "size": [ "default", "default" ], "text": "Hello", "localize": false } } ]
        }
      },
      {
        "def_stack_box@juc_lay.box": {
          "offset": [ 210, 0 ],
          "controls": [ { "t": { "type": "stack_panel", "size": [ "default", "default" ], "controls": [ { "c@juc_lay.cell": { "size": [ 20, 10 ] } } ] } } ]
        }
      },
      {
        "def_grid_box@juc_lay.box": {
          "offset": [ 315, 0 ],
          "controls": [ { "t": { "type": "grid", "size": [ "default", "default" ], "grid_dimensions": [ 2, 2 ], "grid_item_template": "juc_lay.cell" } } ]
        }
      },
      {
        "om_panel_box@juc_lay.box": {
          "offset": [ 0, 45 ],
          "controls": [ { "t": { "type": "panel", "controls": [ { "f@juc_lay.fill": { "size": [ "100%", "100%" ] } } ] } } ]
        }
      },
      {
        "om_label_box@juc_lay.box": {
          "offset": [ 105, 45 ],
          "controls": [ { "t": { "type": "label", "text": "Hello", "localize": false } } ]
        }
      },
      {
        "om_stack_box@juc_lay.box": {
          "offset": [ 210, 45 ],
          "controls": [ { "t": { "type": "stack_panel", "controls": [ { "c@juc_lay.cell": { "size": [ 20, 10 ] } } ] } } ]
        }
      },
      {
        "om_grid_box@juc_lay.box": {
          "offset": [ 315, 45 ],
          "controls": [ { "t": { "type": "grid", "grid_dimensions": [ 2, 2 ], "grid_item_template": "juc_lay.cell" } } ]
        }
      },
      {
        "sibling_box@juc_lay.box": {
          "offset": [ 0, 90 ],
          "controls": [
            { "a@juc_lay.cell": { "size": [ 30, 10 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
            { "b@juc_lay.cell": { "size": [ 50, 20 ], "anchor_from": "bottom_right", "anchor_to": "bottom_right" } },
            { "u": { "type": "panel", "controls": [ { "f@juc_lay.fill": { "size": [ "100%", "100%" ], "alpha": 0.2 } } ] } }
          ]
        }
      },
      {
        "cycle_box@juc_lay.box": {
          "offset": [ 105, 90 ],
          "controls": [
            {
              "p": {
                "type": "panel", "size": [ "100%c", "100%c" ], "anchor_from": "top_left", "anchor_to": "top_left",
                "controls": [
                  { "k@juc_lay.cell": { "size": [ 40, 10 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
                  { "h@juc_lay.cell": { "size": [ "50%", 20 ], "anchor_from": "bottom_right", "anchor_to": "bottom_right" } }
                ]
              }
            }
          ]
        }
      },
      {
        "sizebind_box@juc_lay.box": {
          "offset": [ 210, 90 ],
          "controls": [
            {
              "s": {
                "type": "stack_panel", "size": [ "100%", "100%" ], "collection_name": "form_buttons",
                "controls": [
                  {
                    "half@juc_lay.value_reader": {
                      "collection_index": 4, "size": [ 10, 10 ],
                      "bindings": [
                        { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                        { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#size_binding_x" }
                      ]
                    }
                  },
                  {
                    "half_ao@juc_lay.value_reader": {
                      "collection_index": 4, "size": [ 10, 10 ], "use_anchored_offset": true,
                      "bindings": [
                        { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                        { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#size_binding_x" }
                      ]
                    }
                  },
                  {
                    "two@juc_lay.value_reader": {
                      "collection_index": 5, "size": [ 10, 10 ],
                      "bindings": [
                        { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                        { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#size_binding_x" }
                      ]
                    }
                  },
                  {
                    "abs20@juc_lay.value_reader": {
                      "collection_index": 7, "size": [ 10, 10 ],
                      "bindings": [
                        { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                        { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#size_binding_x_absolute" }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "anchor_box@juc_lay.box": {
          "offset": [ 315, 90 ],
          "controls": [
            {
              "s": {
                "type": "stack_panel", "size": [ "100%", "100%" ], "collection_name": "form_buttons",
                "controls": [
                  {
                    "w": {
                      "type": "panel", "size": [ "100%", "100%" ], "collection_index": 6,
                      "controls": [
                        {
                          "ao_tl@juc_lay.value_reader": {
                            "size": [ 6, 6 ], "use_anchored_offset": true,
                            "bindings": [
                              { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                              { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#anchored_offset_value_x" }
                            ]
                          }
                        },
                        {
                          "ao_c@juc_lay.value_reader": {
                            "size": [ 6, 6 ], "use_anchored_offset": true, "anchor_from": "center", "anchor_to": "center",
                            "bindings": [
                              { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                              { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#anchored_offset_value_x" }
                            ]
                          }
                        },
                        {
                          "ao_abs@juc_lay.value_reader": {
                            "size": [ 6, 6 ], "use_anchored_offset": true, "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 0, 10 ],
                            "bindings": [
                              { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                              { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#anchored_offset_value_x_absolute" }
                            ]
                          }
                        },
                        {
                          "ao_bl@juc_lay.value_reader": {
                            "size": [ 6, 6 ], "use_anchored_offset": true, "anchor_from": "bottom_left", "anchor_to": "bottom_left",
                            "bindings": [
                              { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                              { "binding_type": "view", "binding_condition": "always", "source_property_name": "((#v - 0) * .01)", "target_property_name": "#anchored_offset_value_x" }
                            ]
                          }
                        },
                        {
                          "ao_none@juc_lay.value_reader": {
                            "size": [ 6, 6 ], "anchor_from": "top_right", "anchor_to": "top_right",
                            "bindings": [
                              { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
                              { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#v - 0)", "target_property_name": "#anchored_offset_value_x" }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "grid_hide_box@juc_lay.box": {
          "offset": [ 0, 135 ],
          "controls": [
            {
              "g": {
                "type": "grid", "size": [ 80, 10 ], "anchor_from": "top_left", "anchor_to": "top_left",
                "grid_dimensions": [ 4, 1 ], "grid_item_template": "juc_lay.grid_cell", "collection_name": "form_buttons"
              }
            },
            {
              "s": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ 80, 10 ], "offset": [ 0, 15 ],
                "anchor_from": "top_left", "anchor_to": "top_left", "collection_name": "form_buttons",
                "controls": [
                  { "c0@juc_lay.grid_cell": { "collection_index": 0 } },
                  { "c1@juc_lay.grid_cell": { "collection_index": 1 } },
                  { "c2@juc_lay.grid_cell": { "collection_index": 2 } },
                  { "c3@juc_lay.grid_cell": { "collection_index": 3 } }
                ]
              }
            }
          ]
        }
      },
      {
        "hide_box@juc_lay.box": {
          "offset": [ 105, 135 ],
          "controls": [
            { "h_true@juc_lay.hideable": { "$hide": true } },
            { "h_false@juc_lay.hideable": { "$hide": false } },
            { "h_default@juc_lay.hideable": {} }
          ]
        }
      }
    ]
  },

  "window": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 20,
    "$window_title": "P2 layout",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      { "body@juc_lay.body": { "layer": 2, "size": [ 420, 190 ], "offset": [ 4, 14 ], "anchor_from": "top_left", "anchor_to": "top_left" } }
    ]
  }
}
