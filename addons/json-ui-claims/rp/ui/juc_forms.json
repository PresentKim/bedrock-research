{
  "namespace": "juc_forms",

  "state_image": { "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ] },

  "radio": {
    "type": "panel",
    "size": [ 16, 10 ],
    "controls": [
      {
        "rt@common.toggle": {
          "size": [ "100%", "100%" ],
          "$radio_toggle_group": true,
          "$toggle_name": "$group",
          "$toggle_group_forced_index": "$index",
          "controls": [
            { "unchecked@juc_forms.state_image": { "alpha": 0.25 } },
            { "checked@juc_forms.state_image": { "color": [ 0.3, 1, 0.3 ] } },
            { "unchecked_hover@juc_forms.state_image": { "alpha": 0.4 } },
            { "checked_hover@juc_forms.state_image": { "color": [ 0.5, 1, 0.5 ] } },
            { "unchecked_locked@juc_forms.state_image": { "alpha": 0.1 } },
            { "checked_locked@juc_forms.state_image": { "alpha": 0.1 } },
            { "unchecked_locked_hover@juc_forms.state_image": { "alpha": 0.1 } },
            { "checked_locked_hover@juc_forms.state_image": { "alpha": 0.1 } }
          ]
        }
      }
    ]
  },

  "grid_radio": {
    "type": "panel",
    "size": [ 16, 10 ],
    "controls": [
      {
        "rt@common.toggle": {
          "size": [ "100%", "100%" ],
          "$radio_toggle_group": true,
          "$toggle_name": "juc_gradio",
          "controls": [
            { "unchecked@juc_forms.state_image": { "alpha": 0.25 } },
            { "checked@juc_forms.state_image": { "color": [ 0.3, 1, 0.3 ] } },
            { "unchecked_hover@juc_forms.state_image": { "alpha": 0.4 } },
            { "checked_hover@juc_forms.state_image": { "color": [ 0.5, 1, 0.5 ] } },
            { "unchecked_locked@juc_forms.state_image": { "alpha": 0.1 } },
            { "checked_locked@juc_forms.state_image": { "alpha": 0.1 } },
            { "unchecked_locked_hover@juc_forms.state_image": { "alpha": 0.1 } },
            { "checked_locked_hover@juc_forms.state_image": { "alpha": 0.1 } }
          ]
        }
      }
    ]
  },

  "text_label": {
    "type": "label", "size": [ 120, 8 ], "font_scale_factor": 0.8, "localize": false, "color": [ 1, 1, 0.4 ], "text": "#text"
  },

  "window": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 20,
    "$window_title": "P4 form controls",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      {
        "body": {
          "type": "stack_panel", "layer": 2, "size": [ 200, "100%c" ], "offset": [ 4, 14 ],
          "anchor_from": "top_left", "anchor_to": "top_left",
          "controls": [
            {
              "len@juc_forms.text_label": {
                "bindings": [
                  { "binding_name": "#form_button_length", "binding_condition": "always" },
                  { "binding_type": "view", "binding_condition": "always", "source_property_name": "('len ' + #form_button_length)", "target_property_name": "#text" }
                ]
              }
            },
            {
              "col02": {
                "type": "stack_panel", "size": [ 120, "100%c" ], "collection_name": "form_buttons",
                "controls": [
                  {
                    "direct@juc_forms.text_label": {
                      "collection_index": 1,
                      "bindings": [
                        { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "always" },
                        { "binding_type": "view", "binding_condition": "always", "source_property_name": "('direct ' + #form_button_text)", "target_property_name": "#text" }
                      ]
                    }
                  },
                  {
                    "wrapped": {
                      "type": "panel", "size": [ 120, 8 ], "collection_index": 2,
                      "controls": [
                        {
                          "l@juc_forms.text_label": {
                            "bindings": [
                              { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "always" },
                              { "binding_type": "view", "binding_condition": "always", "source_property_name": "('wrapped ' + #form_button_text)", "target_property_name": "#text" }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "radios": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ 200, 10 ],
                "controls": [
                  {
                    "pa": {
                      "type": "stack_panel", "orientation": "horizontal", "size": [ 40, 10 ],
                      "controls": [
                        { "ra0@juc_forms.radio": { "$group": "juc_radio", "$index": 0 } },
                        { "ra1@juc_forms.radio": { "$group": "juc_radio", "$index": 1 } }
                      ]
                    }
                  },
                  {
                    "pb": {
                      "type": "stack_panel", "orientation": "horizontal", "size": [ 40, 10 ],
                      "controls": [
                        { "rb2@juc_forms.radio": { "$group": "juc_radio", "$index": 2 } },
                        { "rb3@juc_forms.radio": { "$group": "juc_radio", "$index": 3 } }
                      ]
                    }
                  },
                  {
                    "gr": {
                      "type": "grid", "size": [ 48, 10 ], "grid_dimensions": [ 3, 1 ],
                      "grid_item_template": "juc_forms.grid_radio"
                    }
                  }
                ]
              }
            },
            {
              "bag_number@juc_forms.text_label": {
                "text": "#pb",
                "property_bag": { "#pb": "(1 + 2)" }
              }
            },
            {
              "bag_string@juc_forms.text_label": {
                "text": "#pb",
                "property_bag": { "#pb": "('A' + 'B')" }
              }
            },
            {
              "bag_plain@juc_forms.text_label": {
                "text": "#pb",
                "property_bag": { "#pb": "plain" }
              }
            }
          ]
        }
      }
    ]
  },

  "gate": {
    "type": "panel",
    "size": [ 1, 1 ],
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_property_name": "((#title_text - 'formA:' - 'formB:') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },

  "structure_view": {
    "type": "custom",
    "renderer": "3d_structure_renderer",
    "size": [ 120, 120 ],
    "$include_entities|default": false,
    "$include_players|default": false,
    "$remove_blocks|default": false,
    "$has_focus|default": false,
    "property_bag": {
      "#has_focus": "$has_focus",
      "#block_position": "$block_position",
      "#bottom_left_block": "$bottom_left_block",
      "#top_right_block": "$top_right_block",
      "#include_entities": "$include_entities",
      "#remove_blocks": "$remove_blocks",
      "#include_players": "$include_players"
    }
  },

  "structure_view_turn@juc_forms.structure_view": {
    "bindings": [
      { "binding_type": "view", "source_control_name": "turn", "source_property_name": "#gesture_delta_source", "target_property_name": "#gesture_delta_source" },
      { "binding_type": "view", "source_control_name": "turn", "source_property_name": "#gesture_mouse_delta_x", "target_property_name": "#gesture_mouse_delta_x" },
      { "binding_type": "view", "source_control_name": "turn", "source_property_name": "#gesture_mouse_delta_y", "target_property_name": "#gesture_mouse_delta_y" }
    ]
  },

  "structure_box_turn": {
    "type": "panel",
    "size": [ 124, 134 ],
    "controls": [
      { "frame": { "type": "image", "texture": "textures/ui/White", "alpha": 0.15, "size": [ 124, 124 ] } },
      { "view@juc_forms.structure_view_turn": { "offset": [ 2, 2 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      { "caption": { "type": "label", "text": "$caption", "localize": false, "font_scale_factor": 0.7, "color": [ 1, 1, 0.4 ], "anchor_from": "bottom_left", "anchor_to": "bottom_left" } }
    ]
  },

  "structure_box_clip": {
    "type": "panel",
    "size": [ 124, 134 ],
    "controls": [
      { "frame": { "type": "image", "texture": "textures/ui/White", "alpha": 0.15, "size": [ 124, 124 ] } },
      {
        "clip": {
          "type": "panel", "size": [ 120, 120 ], "offset": [ 2, 2 ], "anchor_from": "top_left", "anchor_to": "top_left",
          "clips_children": true,
          "controls": [
            { "view@juc_forms.structure_view": { "size": [ 160, 160 ], "offset": [ -20, -20 ], "anchor_from": "bottom_left", "anchor_to": "bottom_left" } }
          ]
        }
      },
      { "caption": { "type": "label", "text": "$caption", "localize": false, "font_scale_factor": 0.7, "color": [ 1, 1, 0.4 ], "anchor_from": "bottom_left", "anchor_to": "bottom_left" } }
    ]
  },

  "structure_box": {
    "type": "panel",
    "size": [ 124, 134 ],
    "controls": [
      { "frame": { "type": "image", "texture": "textures/ui/White", "alpha": 0.15, "size": [ 124, 124 ] } },
      { "view@juc_forms.structure_view": { "offset": [ 2, 2 ], "anchor_from": "top_left", "anchor_to": "top_left" } },
      { "caption": { "type": "label", "text": "$caption", "localize": false, "font_scale_factor": 0.7, "color": [ 1, 1, 0.4 ], "anchor_from": "bottom_left", "anchor_to": "bottom_left" } }
    ]
  },

  "window6": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 20,
    "$window_title": "P6 structure renderer",
    "controls": [
      { "bg@juc.bg": { "alpha": 1.0 } },
      { "title@juc.title": {} },
      {
        "body": {
          "type": "stack_panel", "orientation": "horizontal", "layer": 2, "size": [ 400, 134 ], "offset": [ 4, 14 ],
          "anchor_from": "top_left", "anchor_to": "top_left",
          "controls": [
            { "rel@juc_forms.structure_box_clip": { "$caption": "entities on, clipped", "$include_entities": true, "$block_position": [ 0, 0, 0 ], "$bottom_left_block": [ 0, -60, 0 ], "$top_right_block": [ 10, -55, 10 ] } },
            { "abs@juc_forms.structure_box": { "$caption": "remove_blocks on", "$remove_blocks": true, "$include_entities": true, "$include_players": true, "$block_position": [ 0, 0, 0 ], "$bottom_left_block": [ 0, -60, 0 ], "$top_right_block": [ 10, -55, 10 ] } },
            {
              "turn": {
                "type": "input_panel",
                "size": [ 124, 134 ],
                "focus_enabled": true,
                "gesture_tracking_button": "button.turn_structure",
                "button_mappings": [
                  { "from_button_id": "button.menu_select", "to_button_id": "button.turn_structure", "mapping_type": "pressed", "button_up_right_of_first_refusal": true }
                ],
                "controls": [
                  {
                    "box@juc_forms.structure_box_turn": {
                      "$caption": "has_focus on, drag", "$has_focus": true, "$block_position": [ 0, 0, 0 ], "$bottom_left_block": [ 0, -60, 0 ], "$top_right_block": [ 10, -55, 10 ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "marker_probe": {
    "type": "stack_panel",
    "size": [ 250, "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      { "binding_name": "#title_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#title_text = 'Marker probe')", "target_property_name": "#visible" }
    ],
    "controls": [
      {
        "m1@juc_forms.text_label": {
          "size": [ 250, 8 ],
          "bindings": [
            { "binding_name": "#form_text", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "('no marker: ' + ((#form_text - '~x') = #form_text))", "target_property_name": "#text" }
          ]
        }
      },
      {
        "m2@juc_forms.text_label": {
          "size": [ 250, 8 ],
          "bindings": [
            { "binding_name": "#form_text", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "('head: ' + ('%.5s' * #form_text))", "target_property_name": "#text" }
          ]
        }
      }
    ]
  },

  "cell": {
    "type": "panel",
    "size": [ 30, 8 ],
    "controls": [
      {
        "l@juc_forms.text_label": {
          "size": [ 30, 8 ],
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_condition": "always" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "('c' + #form_button_text)", "target_property_name": "#text" }
          ]
        }
      }
    ]
  },

  "length_factory": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ 200, 8 ],
    "collection_name": "form_buttons"
  },

  "face": {
    "type": "image", "texture": "textures/ui/White", "size": [ "100%", "100%" ], "alpha": "$face_alpha"
  },

  "probe_button@common.button": {
    "size": [ 40, 10 ],
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "locked_control": "locked",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons", "binding_condition": "always" },
      { "binding_type": "collection", "binding_collection_name": "form_buttons", "binding_name": "#form_button_text", "binding_name_override": "#v", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(not (#v = 'a'))", "target_property_name": "#enabled" }
    ],
    "controls": [
      { "default@juc_forms.face": { "$face_alpha": 0.5 } },
      { "hover@juc_forms.face": { "$face_alpha": 0.8 } },
      { "pressed@juc_forms.face": { "$face_alpha": 1.0 } },
      { "locked@juc_forms.face": { "$face_alpha": 0.1 } }
    ]
  },

  "window5": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 20,
    "$window_title": "P5 more claims",
    "controls": [
      { "bg@juc.bg": {} },
      { "title@juc.title": {} },
      {
        "body": {
          "type": "stack_panel", "layer": 2, "size": [ 300, "100%c" ], "offset": [ 4, 14 ],
          "anchor_from": "top_left", "anchor_to": "top_left",
          "controls": [
            {
              "f_contents@juc_forms.length_factory": {
                "factory": { "name": "juc_f_contents", "control_name": "juc_forms.cell" },
                "bindings": [ { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length", "binding_condition": "always" } ]
              }
            },
            {
              "f_plain@juc_forms.length_factory": {
                "factory": { "name": "juc_f_plain", "control_name": "juc_forms.cell" },
                "bindings": [ { "binding_name": "#form_button_length", "binding_name_override": "#collection_length", "binding_condition": "always" } ]
              }
            },
            {
              "f_minus@juc_forms.length_factory": {
                "factory": { "name": "juc_f_minus", "control_name": "juc_forms.cell" },
                "bindings": [ { "binding_name": "(#form_button_length - 1)", "binding_name_override": "#collection_length", "binding_condition": "always" } ]
              }
            },
            {
              "f_one@juc_forms.length_factory": {
                "factory": { "name": "juc_f_one", "control_name": "juc_forms.cell" },
                "bindings": [ { "binding_name": "((#form_button_length * 0) + 1)", "binding_name_override": "#collection_length", "binding_condition": "always" } ]
              }
            },
            {
              "g_plain": {
                "type": "grid", "size": [ 240, 8 ], "grid_rescaling_type": "horizontal", "grid_item_template": "juc_forms.cell",
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "#form_button_length", "binding_name_override": "#maximum_grid_items", "binding_condition": "always_when_visible" }
                ]
              }
            },
            {
              "g_minus": {
                "type": "grid", "size": [ 240, 8 ], "grid_rescaling_type": "horizontal", "grid_item_template": "juc_forms.cell",
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "(#form_button_length - 1)", "binding_name_override": "#maximum_grid_items", "binding_condition": "always_when_visible" }
                ]
              }
            },
            {
              "orchain": {
                "type": "stack_panel", "size": [ 200, "100%c" ], "collection_name": "form_buttons",
                "controls": [
                  { "e1@juc_expr.row": { "collection_index": 0, "$d": "v = a", "$x": "('R' + (#v = 'a'))" } },
                  { "e2@juc_expr.row": { "collection_index": 0, "$d": "not (v = a)", "$x": "('R' + (not (#v = 'a')))" } },
                  { "e3@juc_expr.row": { "collection_index": 0, "$d": "v=a or v=b", "$x": "('R' + ((#v = 'a') or (#v = 'b')))" } },
                  { "e4@juc_expr.row": { "collection_index": 0, "$d": "not v=v", "$x": "('R' + (not (#v = #v)))" } },
                  { "o1@juc_expr.row": { "collection_index": 0, "$d": "a: !a or b", "$x": "('R' + ((not (#v = 'a')) or (#v = 'b')))" } },
                  { "o2@juc_expr.row": { "collection_index": 0, "$d": "a: b or !a", "$x": "('R' + ((#v = 'b') or (not (#v = 'a'))))" } },
                  { "o3@juc_expr.row": { "collection_index": 0, "$d": "a: !a or !c", "$x": "('R' + ((not (#v = 'a')) or (not (#v = 'c'))))" } },
                  { "o4@juc_expr.row": { "collection_index": 0, "$d": "a: !a or !c or !d", "$x": "('R' + ((not (#v = 'a')) or (not (#v = 'c')) or (not (#v = 'd'))))" } },
                  { "o5@juc_expr.row": { "collection_index": 0, "$d": "a: (!a or !c) or !d", "$x": "('R' + (((not (#v = 'a')) or (not (#v = 'c'))) or (not (#v = 'd'))))" } },
                  { "o6@juc_expr.row": { "collection_index": 0, "$d": "a: b or c or a", "$x": "('R' + ((#v = 'b') or (#v = 'c') or (#v = 'a')))" } },
                  { "o7@juc_expr.row": { "collection_index": 0, "$d": "a: not (a and c)", "$x": "('R' + (not ((#v = 'a') and (#v = 'c'))))" } },
                  { "o8@juc_expr.row": { "collection_index": 0, "$d": "a: !a and a", "$x": "('R' + ((not (#v = 'a')) and (#v = 'a')))" } },
                  { "o9@juc_expr.row": { "collection_index": 0, "$d": "a: (a = false) or b", "$x": "('R' + (((#v = 'a') = false) or (#v = 'b')))" } },
                  { "o11@juc_expr.row": { "collection_index": 0, "$d": "a: not a or b (no paren)", "$x": "('R' + (not (#v = 'a') or (#v = 'b')))" } },
                  { "o12@juc_expr.row": { "collection_index": 0, "$d": "a: vanilla style", "$x": "('R' + (not #v and (not #v or (#v = 'a'))))" } },
                  { "o10@juc_expr.row": { "collection_index": 0, "$d": "a: not a, then or", "$x": "('R' + ((#v = 'b') or ((not (#v = 'a')) = true)))" } }
                ]
              }
            },
            {
              "buttons": {
                "type": "stack_panel", "orientation": "horizontal", "size": [ 100, 10 ], "collection_name": "form_buttons",
                "controls": [
                  { "btn_a@juc_forms.probe_button": { "collection_index": 0 } },
                  { "gap": { "type": "panel", "size": [ 10, 10 ] } },
                  { "btn_b@juc_forms.probe_button": { "collection_index": 1 } }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
