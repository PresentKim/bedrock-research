{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bwiki:juc_counter",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/entity/juc/red"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.spawn_counter = 0;",
        "per_update_expression": "v.size_counter = 0;"
      },
      "minecraft:emitter_rate_instant": { "num_particles": 8 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": {
        "offset": [ "v.spawn_index = v.spawn_counter; v.spawn_counter = v.spawn_counter + 1; return v.spawn_index * 0.6;", 0, 0 ]
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 20 },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.size_index = v.size_counter; v.size_counter = v.size_counter + 1; return 0.05 + v.size_index * 0.03;",
          "0.05 + v.size_index * 0.03"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [ 0, 0 ], "uv_size": [ 16, 16 ] }
      }
    }
  }
}
