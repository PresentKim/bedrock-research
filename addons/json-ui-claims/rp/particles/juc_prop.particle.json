{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bwiki:juc_prop",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/entity/juc/white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.5 },
      "minecraft:emitter_shape_point": { "offset": [ 0, 2, 0 ] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.6 },
      "minecraft:particle_appearance_billboard": {
        "size": [ "0.05 + q.property('bwiki:size') * 0.1", "0.05 + q.property('bwiki:size') * 0.1" ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [ 0, 0 ], "uv_size": [ 16, 16 ] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [ "query.can_fly ? 0.1 : 1", 0.2, "query.can_fly ? 1 : 0.1", 1 ]
      }
    }
  }
