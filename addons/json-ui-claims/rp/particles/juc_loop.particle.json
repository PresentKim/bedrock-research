{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bwiki:juc_loop",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/entity/juc/white" }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.s = 0; loop(5, { v.s = v.s + 1; }); v.b = 0; loop(10, { v.b = v.b + 1; (v.b >= 3) ? { break; }; });"
      },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": { "offset": [ 0, 0, 0 ] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 10 },
      "minecraft:particle_appearance_billboard": {
        "size": [ "0.05 + v.s * 0.1", "0.05 + v.s * 0.1" ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [ 0, 0 ], "uv_size": [ 16, 16 ] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [ "v.b == 3 ? 0 : 1", "v.b == 3 ? 1 : 0", "v.b == 10 ? 1 : 0", 1 ]
      }
    }
  }
}
