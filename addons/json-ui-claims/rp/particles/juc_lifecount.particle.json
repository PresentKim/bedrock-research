{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bwiki:juc_lifecount",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/entity/juc/white" }
    },
    "components": {
      "minecraft:emitter_initialization": { "creation_expression": "v.index = 0; v.sc = 0;" },
      "minecraft:emitter_rate_instant": { "num_particles": 5 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": {
        "offset": [ "v.si = v.sc; v.sc = v.sc + 1; return v.si * 0.6;", 0, 0 ]
      },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "v.index = v.index + 1; return 2 + v.index * 2;" },
      "minecraft:particle_appearance_billboard": {
        "size": [ "v.particle_lifetime * 0.025", "v.particle_lifetime * 0.025" ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [ 0, 0 ], "uv_size": [ 16, 16 ] }
      },
      "minecraft:particle_appearance_tinting": { "color": [ 1, 0.6, 0, 1 ] }
    }
  }
}
