{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bwiki:juc_render_counter",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/entity/juc/white" }
    },
    "components": {
      "minecraft:emitter_initialization": { "creation_expression": "v.n = 0; v.sc = 0;" },
      "minecraft:emitter_rate_instant": { "num_particles": 6 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": {
        "offset": [ "v.si = v.sc; v.sc = v.sc + 1; return v.si * 0.6;", 0, 0 ]
      },
      "minecraft:particle_initialization": { "per_render_expression": "v.n = v.n + 1; v.my = v.n;" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 10 },
      "minecraft:particle_appearance_billboard": {
        "size": [ "0.05 + math.mod(v.my, 600) / 600 * 0.4", "0.05 + math.mod(v.my, 600) / 600 * 0.4" ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [ 0, 0 ], "uv_size": [ 16, 16 ] }
      },
      "minecraft:particle_appearance_tinting": { "color": [ 0.2, 0.4, 1, 1 ] }
    }
  }
}
