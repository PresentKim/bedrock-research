{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.juc.weight": {
      "initial_state": "default",
      "states": {
        "default": { "animations": [ { "tilt": "q.property('bwiki:w')" } ] }
      }
    },
    "controller.animation.juc.bit0": {
      "initial_state": "stop",
      "states": {
        "stop": { "transitions": [ { "play": "math.mod(math.floor(q.property('bwiki:bits') / 1), 2) != 0" } ] },
        "play": {
          "animations": [ "lift_left" ],
          "transitions": [ { "stop": "math.mod(math.floor(q.property('bwiki:bits') / 1), 2) == 0" } ]
        }
      }
    },
    "controller.animation.juc.bit13": {
      "initial_state": "stop",
      "states": {
        "stop": { "transitions": [ { "play": "math.mod(math.floor(q.property('bwiki:bits') / 8192), 2) != 0" } ] },
        "play": {
          "animations": [ "lift_right" ],
          "transitions": [ { "stop": "math.mod(math.floor(q.property('bwiki:bits') / 8192), 2) == 0" } ]
        }
      }
    }
  }
}
