{
  "format_version": "1.8.0",
  "animations": {
    "animation.juc.emit": {
      "loop": true,
      "animation_length": 0.5,
      "particle_effects": { "0.0": { "effect": "p" } }
    },
    "animation.juc.tilt": {
      "loop": true,
      "bones": { "body": { "rotation": [ 0, 0, 20 ] } }
    },
    "animation.juc.lift_left": {
      "loop": true,
      "bones": { "left": { "position": [ 0, 12, 0 ] } }
    },
    "animation.juc.lift_right": {
      "loop": true,
      "bones": { "right": { "position": [ 0, 12, 0 ] } }
    },
    "animation.juc.rise": {
      "loop": true,
      "bones": {
        "left": { "position": [ 0, "v.acc * 0.01", 0 ] },
        "right": { "position": [ 0, "q.life_time * 60 * 0.01", 0 ] }
      }
    }
  }
}
